[Unit]
Description=Deliver the latest fleet digest to the operator through the gateway's admin notification path
After=ai-gateway.service
ConditionPathExists=/opt/iiab/ai-gateway/.venv/bin/python

[Service]
Type=oneshot
User=iiab-admin
WorkingDirectory=/opt/iiab/ai-gateway
EnvironmentFile=/opt/iiab/ai-gateway/.env
EnvironmentFile=-/opt/iiab/ai-gateway/.env.local
ExecStart=/opt/iiab/ai-gateway/.venv/bin/python /usr/local/sbin/fleet-digest-send
