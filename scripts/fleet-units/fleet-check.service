[Unit]
Description=Fleet health check across every managed Frappe box (writes /var/lib/fleet, then sends the digest)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/fleet check --all
# status follows the money, as its own step: the check itself changes nothing
ExecStartPost=-/usr/local/sbin/fleet dunning --auto
# through the gateway where one runs (fleet-digest.service), else through the fleet site's Email Account
ExecStartPost=-/usr/local/sbin/fleet digest --send
