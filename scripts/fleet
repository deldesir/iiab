#!/usr/bin/env python3
"""fleet — operate a fleet of Frappe/ERPNext boxes from the hub (v2).

The inventory (/etc/iiab/fleet.yml) is the source of truth: one record per box with its
role, owner, plan, status, canary rank, maintenance window, connectivity class and the
catalog services it carries (scripts/fleet-catalog.yml). Nothing here edits it except
`onboard`, `rename`, `suspend`, `resume`, `offboard` and `manifest set-current`.
Identity: every box has an id (box-NNN, given once at onboarding, never reused), an alias
(short slug the people use; may change) and a host (the customer's domain). Commands
accept id, alias or host; output shows "id alias".

  fleet list | status | tailnet         inventory; last check per box; our nodes as the tailnet sees them
  fleet check [ID...|--all] [--no-push]   OK / WARN / CRIT / STALE per box with levelled
                                          findings; feeds the per-box monitors; writes
                                          /var/lib/fleet/checks/<id>/ and the digest
  fleet digest [--send]
  fleet manifest capture --id ID [--from BOX] [--notes ..] | list | show ID | set-current ID
  fleet upgrade [ID...|--all] [--release ID] [--preflight] [--now] [--allow-discard ERE]
  fleet suspend ID [--reason TEXT] | resume ID | offboard ID
  fleet dunning [--apply]                 boxes with overdue invoices in the fleet site; --apply
                                          suspends those past their grace (nightly when the
                                          inventory says auto_suspend: true)
  fleet rollback ID [--release RID] [--no-restore] [--dry-run] [--now]
                                          undo the box's last upgrade: apps back to the commits
                                          that ran before it and the database/files restored
                                          from the pre-upgrade backup (or go to a manifest)
  fleet push                              mirror inventory, catalog, checks, releases
  fleet agent-token ID                    the stanza for /etc/iiab/fleet-agent.conf on an
                                          offline (push-mode) box
  fleet deploy-agent ID                   install fleet-agent + units on that box (ssh)
  fleet deploy-watchdog ID                install the hub watchdog on a non-hub box (ssh)
  fleet runrole ID ROLE [--tags T]        run an IIAB role on a box through its own runrole
  fleet reboot ID|--all [--now]           reboot inside the window, wait, re-check
  fleet backup-pull [--dest DIR]          mirror the observer's backup copies onto this hub
  fleet vars pull|diff|show [ID...|--all] private copies of each box's local_vars.yml on the hub
  fleet onboard --host H --business B --alias A [--role customer|till|hub|observer] [--owner customer|self]
                                          [--profile P] [--plan P] [--connectivity C] [--services a,b]
                                          [--billing E] [--technical E] [--id box-NNN]   register a box
  fleet rename ID [NEW_ID] [--alias A]    rename everywhere: inventory, history, vars copy, fleet
                                          site record, monitors (+ push token)
  fleet hostname ID [--now]               set the box's OS (and tailnet) hostname to its id
  fleet authorize-key FILE [ID...|--all] [--check]   add a public key to root's authorized_keys on
                                          boxes (a new hub's key); --check only reports

Roles: hub (this control plane; may live at home, intermittently online), observer (an
always-on VPS that runs the monitor, the hub watchdog and fleet-backup-mail), till, customer.
Connectivity: public boxes are probed over https on their host; tailnet boxes over http on
their tailnet address (no TLS/domain checks); offline boxes are never polled: fleet-agent
reports to the fleet site and the hub judges freshness (STALE past the heartbeat allowance,
CRIT past twice). Exit 0 ok, 1 a box is CRIT/STALE or an upgrade failed, 2 usage/config.
"""
from __future__ import annotations

import argparse
import concurrent.futures as cf
import datetime as dt
import hashlib
import hmac
import json
import os
import re
import shlex
import socket
import ssl
import subprocess
import sys
import time
from pathlib import Path
from zoneinfo import ZoneInfo

try:
    import yaml
except ImportError:  # pragma: no cover
    sys.exit("fleet: python3-yaml is required")

INVENTORY = Path(os.environ.get("FLEET_INVENTORY", "/etc/iiab/fleet.yml"))
RELEASES = Path(os.environ.get("FLEET_RELEASES", "/etc/iiab/fleet-releases"))
STATE = Path(os.environ.get("FLEET_STATE", "/var/lib/fleet"))
PUSH_CONF = Path(os.environ.get("FLEET_PUSH_CONF", "/etc/iiab/fleet.conf"))
_here = Path(__file__).resolve().parent
CATALOG = Path(os.environ.get("FLEET_CATALOG") or (
    "/etc/iiab/fleet-catalog.yml" if Path("/etc/iiab/fleet-catalog.yml").exists()
    else _here / "fleet-catalog.yml" if (_here / "fleet-catalog.yml").exists() else "/opt/iiab/iiab/scripts/fleet-catalog.yml"))
SCRIPTS = _here if (_here / "bench-upgrade.sh").exists() else Path("/opt/iiab/iiab/scripts")
UPGRADE_SCRIPT = Path(os.environ.get("FLEET_UPGRADE_SCRIPT") or SCRIPTS / "bench-upgrade.sh")
ROLLBACK_SCRIPT = Path(os.environ.get("FLEET_ROLLBACK_SCRIPT") or SCRIPTS / "bench-rollback.sh")
TARGETS = ["frappe-bench-frappe-schedule", "frappe-bench-web.target", "frappe-bench-workers.target"]
KEEP_CHECKS = 90
HUB_BACKUPS = Path("/library/backups/fleet")
LEVELS = {"CRIT": 3, "STALE": 2, "WARN": 1, "INFO": 0}
ID_RE = re.compile(r"^box-\d{3}$")               # box-001 … box-999: given once, never reused
ALIAS_RE = re.compile(r"^[a-z0-9][a-z0-9-]{1,30}$")   # short slug people type; may change

# ----------------------------------------------------------------------------- config


def parse_conf(text: str) -> dict:
    conf = {}
    for line in text.splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            k, _, v = line.partition("=")
            conf[k.strip()] = v.strip().strip('"')
    return conf


def read_conf(p: Path) -> dict:
    return parse_conf(p.read_text()) if p.exists() else {}


def set_conf(p: Path, key: str, value: str) -> None:
    lines = p.read_text().splitlines() if p.exists() else []
    for i, line in enumerate(lines):
        if line.startswith(f"{key}="):
            lines[i] = f"{key}={value}"
            break
    else:
        lines.append(f"{key}={value}")
    p.write_text("\n".join(lines) + "\n")
    os.chmod(p, 0o600)


def load_catalog() -> dict:
    if not Path(CATALOG).exists():
        return {"services": {}}
    return yaml.safe_load(Path(CATALOG).read_text()) or {"services": {}}


def load_inventory() -> dict:
    if not INVENTORY.exists():
        sys.exit(f"fleet: inventory {INVENTORY} missing")
    inv = yaml.safe_load(INVENTORY.read_text()) or {}
    inv.setdefault("defaults", {})
    inv.setdefault("boxes", [])
    for b in inv["boxes"]:
        for k, v in inv["defaults"].items():
            b.setdefault(k, v)
        b.setdefault("local", False)
        b.setdefault("status", "active")
        b.setdefault("canary_rank", 99)
        b.setdefault("connectivity", "public")
        b.setdefault("services", [])
        b.setdefault("alias", b["id"])
        reach = dict(b.get("reach") or {})
        reach.setdefault("ssh", b["host"])
        reach.setdefault("http", f"https://{b['host']}" if b["connectivity"] == "public" else f"http://{reach['ssh']}")
        b["reach"] = reach
        b["mode"] = "push" if b["connectivity"] == "offline" else "pull"
    return inv


def save_inventory(inv: dict) -> None:
    """Write the inventory back without the derived/defaulted keys. Works on a deep copy so the
    records in memory keep their resolved form for the rest of the run."""
    import copy
    text = INVENTORY.read_text()
    header = "".join(line for line in text.splitlines(keepends=True) if line.startswith("#"))
    body = copy.deepcopy(inv)
    for b in body["boxes"]:
        b.pop("mode", None)
        if b.get("reach") == {"ssh": b["host"], "http": f"https://{b['host']}" if b.get("connectivity", "public") == "public" else f"http://{b['host']}"}:
            b.pop("reach", None)
        for k in list(b):
            if k in inv["defaults"] and b[k] == inv["defaults"][k] and k not in ("plan", "status"):
                del b[k]
        if b.get("local") is False:
            del b["local"]
        if b.get("alias") == b["id"]:
            del b["alias"]
    tmp = INVENTORY.with_suffix(".tmp")
    tmp.write_text(header + yaml.safe_dump(body, sort_keys=False, allow_unicode=True, width=100))
    os.chmod(tmp, 0o640)
    tmp.replace(INVENTORY)


def select_boxes(inv: dict, ids: list[str], all_: bool) -> list[dict]:
    boxes = sorted(inv["boxes"], key=lambda b: (b["canary_rank"], b["id"]))
    if all_ or not ids:
        return boxes
    by_id = {b["id"]: b for b in boxes}
    by_alias = {b["alias"]: b for b in boxes}
    by_host = {b["host"]: b for b in boxes}
    out = []
    for i in ids:
        b = by_id.get(i) or by_alias.get(i) or by_host.get(i)
        if not b:
            sys.exit(f"fleet: unknown box {i!r} (known: {', '.join(label(b) for b in boxes)})")
        out.append(b)
    return out


def label(b: dict) -> str:
    """How a box is named in output: 'box-003 malianova' (id, then alias when it differs)."""
    return f"{b['id']} {b['alias']}" if b.get("alias") and b["alias"] != b["id"] else b["id"]


_COLORS = {"green": "32", "yellow": "33", "red": "31", "magenta": "35", "bold": "1", "dim": "2"}
_STATE_COLOR = {"OK": "green", "WARN": "yellow", "CRIT": "red", "STALE": "magenta", "FAILED": "red", "INFO": "dim"}


def paint(text: str, color: str) -> str:
    """Colour on a terminal only: logs, Semaphore runs and mail get plain text (NO_COLOR respected)."""
    if not sys.stdout.isatty() or os.environ.get("NO_COLOR"):
        return text
    return f"\033[{_COLORS[color]}m{text}\033[0m"


def state(word: str, width: int = 0) -> str:
    """A check state (OK / WARN / CRIT / STALE) coloured, padded to width before colouring."""
    return paint(f"{word:<{width}}", _STATE_COLOR.get(word, "bold"))


# ----------------------------------------------------------------------------- remote exec


def run_on(box: dict, cmd: str, timeout: int = 120) -> tuple[int, str]:
    if box.get("local"):
        argv = ["bash", "-c", cmd]
    else:
        argv = ["ssh", "-o", "BatchMode=yes", "-o", "ConnectTimeout=10", f"{box['ssh_user']}@{box['reach']['ssh']}", cmd]
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout)
    except subprocess.TimeoutExpired:
        return 124, "timeout"
    return p.returncode, (p.stdout + p.stderr).strip()


def scp_to(box: dict, src: Path, dest: str, mode: str = "0755") -> None:
    if box.get("local"):
        subprocess.run(["install", "-m", mode, str(src), dest], check=True)
    else:
        subprocess.run(["scp", "-q", "-o", "BatchMode=yes", str(src), f"{box['ssh_user']}@{box['reach']['ssh']}:{dest}"], check=True)
        run_on(box, f"chmod {mode} {shlex.quote(dest)}")


def bench(box: dict, args: str) -> str:
    return f"sudo -u frappe -H bash -lc {shlex.quote(f'cd {box['bench']} && bench {args}')}"


# ----------------------------------------------------------------------------- releases


def manifest_path(rid: str) -> Path:
    if not re.fullmatch(r"[A-Za-z0-9._-]+", rid):
        sys.exit("fleet: release id may contain letters, digits, . _ -")
    return RELEASES / f"{rid}.manifest"


def read_manifest(rid: str) -> dict[str, str]:
    p = manifest_path(rid)
    if not p.exists():
        sys.exit(f"fleet: no release {rid} ({p})")
    heads = {}
    for line in p.read_text().splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            k, _, v = line.partition("=")
            heads[k.strip()] = v.strip()
    return heads


def manifest_apps(m: dict[str, str]) -> dict[str, str]:
    return {k: v for k, v in m.items() if k not in ("release", "captured", "notes") and re.fullmatch(r"[0-9a-f]{40}", v or "")}


def heads_of(box: dict) -> dict[str, str]:
    """Every app in the bench's apps.txt -> full commit (bench-upgrade.sh uses the same list)."""
    cmd = (f"for a in $(cat {box['bench']}/sites/apps.txt 2>/dev/null); do "
           f"printf '%s=%s\\n' $a $(sudo -u frappe git -C {box['bench']}/apps/$a rev-parse HEAD 2>/dev/null || echo '?'); done")
    rc, out = run_on(box, cmd)
    heads = {}
    for line in out.splitlines():
        k, _, v = line.partition("=")
        if k and re.fullmatch(r"[a-z_0-9]+", k):
            heads[k] = v.strip()
    return heads


def cmd_manifest(a, inv):
    RELEASES.mkdir(parents=True, exist_ok=True)
    if a.action == "capture":
        box = select_boxes(inv, [a.from_box] if a.from_box else ["hub"], False)[0]
        heads = heads_of(box)
        bad = [k for k, v in heads.items() if v == "?"]
        if not heads or bad:
            sys.exit(f"fleet: could not read heads on {box['id']}: {bad or 'none'}")
        p = manifest_path(a.id)
        if p.exists() and not a.force:
            sys.exit(f"fleet: {p} exists (use --force to overwrite)")
        stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
        lines = [f"# fleet release {a.id} — captured {stamp} from {box['id']}",
                 "# app=full commit; bench-upgrade.sh pins each app it finds on the box to exactly this commit",
                 f"release={a.id}", f"captured={stamp}"]
        if a.notes:
            lines.append(f"notes={a.notes}")
        lines += [f"{k}={v}" for k, v in sorted(heads.items())]
        p.write_text("\n".join(lines) + "\n")
        print(f"captured {a.id} -> {p}")
        for k, v in sorted(heads.items()):
            print(f"  {k:<10} {v[:10]}")
    elif a.action == "list":
        cur = inv.get("current_release") or ""
        for p in sorted(RELEASES.glob("*.manifest")):
            m = read_manifest(p.stem)
            print(f"{p.stem:<18} {m.get('captured', '?'):<22} {len(manifest_apps(m))} apps{'  (current)' if p.stem == cur else ''}")
    elif a.action == "show":
        for k, v in read_manifest(a.id).items():
            print(f"{k}={v}")
    elif a.action == "set-current":
        read_manifest(a.id)
        inv["current_release"] = a.id
        save_inventory(inv)
        print(f"current_release = {a.id}")
    return 0


# ----------------------------------------------------------------------------- probes


def http_code(url: str, timeout: int = 20) -> str:
    try:
        return subprocess.run(["curl", "-s", "-o", "/dev/null", "-m", str(timeout), "-w", "%{http_code}", "-L", url],
                              capture_output=True, text=True, timeout=timeout + 5).stdout.strip() or "000"
    except subprocess.TimeoutExpired:
        return "000"


def box_http_code(box: dict, url: str, timeout: int = 20) -> str:
    """HTTP status as the box itself sees it: for services that only listen on its loopback (the
    hub-kind probes), which the machine running the check cannot reach once the hub and the box
    that carries the service are no longer the same computer."""
    rc, out = run_on(box, f"curl -s -o /dev/null -m {timeout} -w '%{{http_code}}' -L {shlex.quote(url)}", timeout=timeout + 15)
    code = out.strip()[-3:]
    return code if rc == 0 and code.isdigit() else "000"


def local_addresses() -> set[str]:
    """Names and addresses this machine answers to (its tailnet address included)."""
    out = subprocess.run(["hostname", "-I"], capture_output=True, text=True).stdout.split()
    return set(out) | {socket.gethostname(), socket.getfqdn(), "localhost", "127.0.0.1"}


def tls_days_left(host: str) -> int | None:
    try:
        ctx = ssl.create_default_context()
        with socket.create_connection((host, 443), timeout=10) as s, ctx.wrap_socket(s, server_hostname=host) as ss:
            cert = ss.getpeercert()
        exp = dt.datetime.strptime(cert["notAfter"], "%b %d %H:%M:%S %Y %Z").replace(tzinfo=dt.timezone.utc)
        return (exp - dt.datetime.now(dt.timezone.utc)).days
    except Exception:
        return None


def domain_info(host: str) -> dict:
    """Registrar and expiry via RDAP, cached a day (failures cache too)."""
    cache = STATE / "rdap"
    cache.mkdir(parents=True, exist_ok=True)
    f = cache / f"{host}.json"
    if f.exists() and time.time() - f.stat().st_mtime < 86400:
        return json.loads(f.read_text())
    import urllib.request
    tld = host.rsplit(".", 1)[-1]
    out = {"registrar": None, "expiry": None, "days_left": None}
    for url in (f"https://rdap.org/domain/{host}", f"https://rdap.nic.{tld}/domain/{host}"):
        try:
            req = urllib.request.Request(url, headers={"Accept": "application/rdap+json", "User-Agent": "fleet-check"})
            with urllib.request.urlopen(req, timeout=15) as r:
                j = json.load(r)
        except Exception:
            continue
        exp = next((e.get("eventDate") for e in j.get("events", []) if e.get("eventAction") == "expiration"), None)
        reg = None
        for ent in j.get("entities", []):
            if "registrar" in (ent.get("roles") or []):
                reg = next((v[3] for v in (ent.get("vcardArray") or [None, []])[1] if v and v[0] == "fn"), None)
                break
        if exp:
            d = dt.datetime.fromisoformat(exp.replace("Z", "+00:00"))
            out = {"registrar": reg, "expiry": d.date().isoformat(), "days_left": (d - dt.datetime.now(dt.timezone.utc)).days}
            break
    f.write_text(json.dumps(out))
    return out


_BACKUP_BOX: dict | None = None   # the box running fleet-backup-mail when it is not this machine


def hub_backup_age_hours(host: str) -> float | None:
    d = HUB_BACKUPS / host
    if not d.is_dir() and _BACKUP_BOX:
        rc, out = run_on(_BACKUP_BOX, f"f=$(ls -t {HUB_BACKUPS}/{host}/*/*-database*.sql.gz {HUB_BACKUPS}/{host}/*/control-plane-export-*.tar.gpg 2>/dev/null | head -1); [ -n \"$f\" ] && echo $(( ($(date +%s) - $(stat -c %Y \"$f\")) / 3600 )) || echo none")
        return float(out.strip()) if rc == 0 and out.strip().replace(".", "").isdigit() else None
    if not d.is_dir():
        return None
    newest = None
    for sub in d.iterdir():
        if sub.is_dir() and re.fullmatch(r"\d{4}-\d{2}-\d{2}", sub.name):
            for f in [*sub.glob("*-database*.sql.gz"), *sub.glob("control-plane-export-*.tar.gpg")]:
                m = f.stat().st_mtime
                newest = m if newest is None or m > newest else newest
    return None if newest is None else round((time.time() - newest) / 3600, 1)


REMOTE_PROBE = r"""
B={bench}; S={site}
db=$(python3 -c "import json;print(json.load(open('$B/sites/$S/site_config.json'))['db_name'])" 2>/dev/null)
echo "targets=$(systemctl is-active {targets} 2>/dev/null | tr '\n' ' ')"
echo "failed_units=$(systemctl --failed --no-legend | wc -l)"
echo "failed_list=$(systemctl --failed --no-legend --plain | awk '{{print $1}}' | tr '\n' ',')"
LOGDB=$B/sites/$S/private/files/sqlite.db   # Frappe keeps Error Log in a per-site SQLite file now; the MariaDB table is a leftover on older sites
echo "errorlog=$( ( [ -r "$LOGDB" ] && python3 -c "import sqlite3; c=sqlite3.connect('file:$LOGDB?mode=ro', uri=True); print(c.execute('select count(*) from \"tabError Log\" where creation > ?', ('{since}',)).fetchone()[0])" 2>/dev/null ) || mysql -N -e "select count(*) from \`tabError Log\` where creation > '{since}'" $db 2>/dev/null || echo '?')"
echo "open_shifts=$(mysql -N -e "select count(*) from \`tabPOS Opening Shift\` where status='Open' and docstatus=1" $db 2>/dev/null || echo '?')"
echo "hotel_business_date=$(mysql -N -e "select max(business_date) from \`tabProperty\` where is_active=1" $db 2>/dev/null)"   # empty where there is no PMS
echo "disk_free_gb=$(df -BG --output=avail / | awk 'NR==2{{print $1+0}}')"
echo "ram_avail_mb=$(awk '/MemAvailable/{{print int($2/1024)}}' /proc/meminfo)"
echo "load1=$(cut -d' ' -f1 /proc/loadavg)"
echo "box_backup_age_h=$(f=$(ls -t $B/sites/$S/private/backups/*-database*.sql.gz 2>/dev/null | head -1); [ -n "$f" ] && echo $(( ($(date +%s) - $(stat -c %Y "$f")) / 3600 )) || echo '?')"
echo "maintenance=$(python3 -c "import json;print(json.load(open('$B/sites/$S/site_config.json')).get('maintenance_mode',0))" 2>/dev/null)"
echo "uptime_s=$(cut -d. -f1 /proc/uptime)"
echo "reboot_required=$([ -f /var/run/reboot-required ] && echo 1 || echo 0)"
echo "kernel_running=$(uname -r)"
echo "kernel_newest=$(ls /boot/vmlinuz-* 2>/dev/null | sed 's/.*vmlinuz-//' | sort -V | tail -1)"
echo "units={units_out}"
"""


def collect_pull(box: dict, catalog: dict) -> dict:
    """Raw metrics of a box the hub can reach. Severity is decided in evaluate()."""
    tz = ZoneInfo(box.get("timezone") or "UTC")
    since = dt.datetime.now(tz).strftime("%Y-%m-%d 00:00:00")
    raw: dict = {"heads": heads_of(box)}
    if not raw["heads"]:
        raw["unreachable"] = True
        return raw
    if box["role"] == "hub" and catalog.get("_watchdog_box"):
        raw["_inv_watchdog_box"] = catalog["_watchdog_box"]
    units = list(box.get("monitor_units") or [])
    for sid in box["services"]:
        svc = catalog["services"].get(sid) or {}
        if svc.get("kind") == "box":
            units += svc.get("units") or []
        elif svc.get("kind") == "hub" and box["role"] in ("hub", "observer"):
            units += svc.get("units") or []     # hub-kind services run on the hub/observer; other boxes only receive them
    units = sorted(set(units))
    units_out = ("$(systemctl is-active " + " ".join(shlex.quote(u) for u in units) + " 2>/dev/null | tr '\\n' ',')") if units else ""
    probe = REMOTE_PROBE.format(bench=box["bench"], site=box["site"], targets=" ".join(TARGETS), since=since, units_out=units_out)
    rc, out = run_on(box, probe)
    kv = {}
    for line in out.splitlines():
        k, _, v = line.partition("=")
        kv[k.strip()] = v.strip()
    raw.update({
        "targets": kv.get("targets", ""), "failed_units": kv.get("failed_units", "?"), "failed_list": kv.get("failed_list", ""),
        "errorlog_rows_today": kv.get("errorlog", "?"), "open_shifts": kv.get("open_shifts", "?"),
        "hotel_business_date": kv.get("hotel_business_date", "") or "",
        "disk_free_gb": kv.get("disk_free_gb", "?"), "ram_avail_mb": kv.get("ram_avail_mb", "?"), "load1": kv.get("load1", "?"),
        "box_backup_age_h": kv.get("box_backup_age_h", "?"), "maintenance_mode": kv.get("maintenance", "?"), "uptime_s": kv.get("uptime_s", "?"),
        "monitor_units": dict(zip(units, [s for s in kv.get("units", "").split(",") if s])) if units else {},
        "reboot_required": kv.get("reboot_required", "0"), "kernel_running": kv.get("kernel_running", ""), "kernel_newest": kv.get("kernel_newest", ""),
    })
    # the pipeline's off-box snapshot copy: second-brain-offsite.conf (OFFSITE_HOST, OFFSITE_DIR) lives on
    # the box that runs the assistant; the copy may sit on this machine or on another box
    if "whatsapp-assistant" in box["services"]:
        rc, out = run_on(box, "cat /etc/iiab/second-brain-offsite.conf 2>/dev/null")
        oc = parse_conf(out) if rc == 0 else {}
        if oc.get("OFFSITE_HOST"):
            target = {"ssh_user": "root", "reach": {"ssh": oc["OFFSITE_HOST"]}, "local": oc["OFFSITE_HOST"] in local_addresses()}
            rc, out = run_on(target,
                             f"f=$(ls -t {oc.get('OFFSITE_DIR', '/library/backups/hub-offsite')}/second-brain-*.tar.gpg 2>/dev/null | head -1); [ -n \"$f\" ] && echo $(( ($(date +%s) - $(stat -c %Y \"$f\")) / 3600 )) || echo none")
            raw["offsite_copy_age_h"] = out.strip() if rc == 0 else "unreachable"
            raw["offsite_host"] = oc["OFFSITE_HOST"]
    # HTTP probes from the catalog
    base = box["reach"]["http"].rstrip("/")
    probes = []
    for sid in box["services"]:
        svc = catalog["services"].get(sid) or {}
        if svc.get("kind") == "box":
            probes += [dict(p, service=sid) for p in (svc.get("probes") or [])]
        if svc.get("kind") == "hub":
            probes += [dict(p, service=sid, hub=True) for p in (svc.get("hub_probes") or [])]
    seen, raw["http"], raw["probes"] = set(), {}, []
    for p in probes:
        url = p.get("url") or f"{base}{p['path']}"
        if url in seen:
            continue
        seen.add(url)
        code = box_http_code(box, url) if p.get("hub") else http_code(url)
        raw["http"][p.get("path") or url] = code
        raw["probes"].append({"url": url, "code": code, "expect": str(p.get("expect", 200)), "critical": bool(p.get("critical", True)), "service": p["service"]})
    if box["connectivity"] == "public":
        raw["tls_days_left"] = tls_days_left(box["host"])
        dom = domain_info(box["host"])
        raw["domain_registrar"], raw["domain_expiry"], raw["domain_days_left"] = dom["registrar"], dom["expiry"], dom["days_left"]
    raw["hub_backup_age_h"] = hub_backup_age_hours(box["host"])
    if box["role"] == "hub" and raw.get("_inv_watchdog_box"):
        wd = raw.pop("_inv_watchdog_box")
        rc, out = run_on(wd, "tail -n 30 /var/lib/fleet/hub-watchdog.log 2>/dev/null")
        recent = [l for l in out.splitlines() if l[:19] >= (dt.datetime.now(dt.timezone.utc) - dt.timedelta(hours=48)).strftime("%Y-%m-%dT%H:%M:%S")]
        raw["watchdog"] = {"box": wd["id"], "reachable": rc == 0, "starts_48h": [l for l in recent if "START sent" in l], "lines_48h": len(recent)}
    return raw


def latest_report(box: dict) -> dict | None:
    """Push-mode boxes: the newest report fleet-agent stored in the fleet site."""
    conf = load_push_conf()
    if not conf:
        return None
    import requests
    try:
        r = requests.get(f"{conf['FLEET_SITE_URL'].rstrip('/')}/api/method/fleet_ops.api.latest_report", params={"box_id": box["id"]},
                         headers={"Authorization": f"token {conf['FLEET_API_KEY']}:{conf['FLEET_API_SECRET']}", "Host": conf["FLEET_SITE_NAME"],
                                  "X-Frappe-Site-Name": conf["FLEET_SITE_NAME"]}, timeout=30)
        r.raise_for_status()
        return r.json().get("message") or None
    except Exception as e:
        return {"error": str(e)}


def evaluate(box: dict, raw: dict, inv: dict, catalog: dict) -> dict:
    """Turn raw metrics into levelled findings and a status. Shared by pull and push modes."""
    F: list[dict] = []

    def f(level, code, msg):
        F.append({"level": level, "code": code, "message": msg})

    res = {"id": box["id"], "host": box["host"], "role": box["role"], "connectivity": box["connectivity"], "mode": box["mode"],
           "status_inventory": box["status"], "services": box["services"],
           "checked_at": dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds"), "release_current": inv.get("current_release") or ""}
    res.update({k: v for k, v in raw.items() if k != "findings"})
    suspended = box["status"] == "suspended"
    if raw.get("unreachable"):
        f("CRIT", "unreachable", "unreachable: could not read app heads over ssh")
    if raw.get("stale_h") is not None:
        sla = float(box.get("heartbeat_sla_hours") or 30)
        if raw["stale_h"] >= 2 * sla:
            f("CRIT", "no-report", f"no report for {raw['stale_h']:.0f} h (allowance {sla:.0f} h)")
        elif raw["stale_h"] >= sla:
            f("STALE", "stale", f"last report {raw['stale_h']:.0f} h ago (allowance {sla:.0f} h)")
    if raw.get("report_error"):
        f("STALE", "report-unavailable", raw["report_error"])
    for t, s in zip(TARGETS, (raw.get("targets") or "").split()):
        if s != "active":
            f("CRIT", "target", f"{t} is {s}")
    fu = raw.get("failed_units", "?")
    if fu not in ("0", "?", ""):
        f("WARN", "failed-units", f"{fu} failed systemd unit(s): {raw.get('failed_list', '').strip(',')}")
    disk = raw.get("disk_free_gb", "?")
    if str(disk).isdigit():
        if int(disk) < 5:
            f("CRIT", "disk", f"disk free {disk} GB")
        elif int(disk) < 15:
            f("WARN", "disk", f"disk free {disk} GB")
    for u, st in (raw.get("monitor_units") or {}).items():
        if st != "active":
            f("CRIT", "unit", f"{u} is {st}")
    if "hospitality" in (box.get("services") or []):
        # the PMS's business date advances only when the night audit runs: a date that lags
        # means no room charges are being posted and the front desk is working on yesterday
        bd = raw.get("hotel_business_date") or ""
        today = dt.datetime.now(ZoneInfo(box.get("timezone") or "UTC")).date()
        try:
            lag = (today - dt.date.fromisoformat(bd[:10])).days if bd and bd != "NULL" else None
        except ValueError:
            lag = None
        if lag is None:
            f("WARN", "night-audit", "no active property with a business date (PMS not set up?)")
        elif lag >= 7:
            f("CRIT", "night-audit", f"night audit not run: business date {bd[:10]} is {lag} days behind")
        elif lag >= 2:
            f("WARN", "night-audit", f"night audit not run: business date {bd[:10]} is {lag} days behind")
    for p in raw.get("probes") or []:
        if p["code"] == p["expect"]:
            continue
        if suspended and p["code"] == "503":
            f("INFO", "suspended", f"{p['url']} answers 503 (suspended)")
            continue
        f("CRIT" if p["critical"] else "WARN", "http", f"HTTP {p['code']} on {p['url']} ({p['service']})")
    if box["connectivity"] == "public" and "tls_days_left" in raw:
        d = raw.get("tls_days_left")
        if d is None:
            f("WARN", "tls", "TLS certificate unreadable")
        elif d < 7:
            f("CRIT", "tls", f"TLS certificate expires in {d} days")
        elif d < 14:
            f("WARN", "tls", f"TLS certificate expires in {d} days")
        dd = raw.get("domain_days_left")
        if dd is not None:
            if dd < 7:
                f("CRIT", "domain", f"domain registration expires in {dd} days")
            elif dd < 30:
                f("WARN", "domain", f"domain registration expires in {dd} days")
    age = raw.get("hub_backup_age_h") if box["mode"] == "pull" else None
    if box["mode"] == "pull":
        if age is None or age > 72:
            f("CRIT" if box["status"] in ("active", "grace") else "WARN", "backup", f"hub backup copy stale ({age} h)")
        elif age > 36:
            f("WARN", "backup", f"hub backup copy {age} h old")
    else:
        ba = raw.get("box_backup_age_h", "?")
        if str(ba).isdigit() and int(ba) > 72:
            f("CRIT", "backup", f"box backup {ba} h old")
        elif str(ba).isdigit() and int(ba) > 36:
            f("WARN", "backup", f"box backup {ba} h old")
    el = raw.get("errorlog_rows_today", "?")
    if str(el).isdigit() and int(el) > 50:
        f("WARN", "errorlog", f"{el} Error Log rows today")
    if str(raw.get("maintenance_mode")) == "1" and not suspended:
        f("WARN", "maintenance", "site is in maintenance mode but not suspended")
    up = raw.get("uptime_s", "?")
    if str(up).isdigit() and int(up) < 86400:
        f("INFO", "rebooted", f"booted {int(up) // 3600} h ago")
    kr, kn = raw.get("kernel_running") or "", raw.get("kernel_newest") or ""
    if raw.get("reboot_required") == "1" or (kr and kn and kr != kn):
        f("WARN", "reboot", f"reboot pending (running {kr or '?'}, installed {kn or '?'}); fleet reboot {box['id']} inside its window")
    oa = raw.get("offsite_copy_age_h")
    if oa is not None:
        if oa in ("none", "unreachable"):
            f("WARN", "offsite", f"pipeline off-box copy on {raw.get('offsite_host')}: {oa}")
        elif str(oa).isdigit() and int(oa) > 72:
            f("CRIT", "offsite", f"pipeline off-box copy is {oa} h old")
        elif str(oa).isdigit() and int(oa) > 36:
            f("WARN", "offsite", f"pipeline off-box copy is {oa} h old")
    wd = raw.get("watchdog")
    if wd:
        if not wd.get("reachable"):
            f("WARN", "watchdog", f"hub watchdog box {wd['box']} unreachable")
        for l in wd.get("starts_48h") or []:
            f("WARN", "watchdog", f"watchdog on {wd['box']} started the hub through Contabo: {l[:19]}")
    cur = inv.get("current_release") or ""
    if cur and raw.get("heads"):
        want = manifest_apps(read_manifest(cur))
        behind = [a for a in want if a in raw["heads"] and raw["heads"][a] != want[a]]
        res["behind_release"] = behind
        if behind:
            f("WARN", "release", f"behind {cur}: {', '.join(behind)}")
    worst = max((LEVELS[x["level"]] for x in F), default=-1)
    judge_receivables(box, res, catalog, f)
    res["status"] = {3: "CRIT", 2: "STALE", 1: "WARN"}.get(worst, "OK")
    res["findings"] = F
    res["problems"] = [x["message"] for x in F if x["level"] in ("CRIT", "STALE", "WARN")]
    return res


def judge_receivables(box: dict, res: dict, catalog: dict, f) -> None:
    """Overdue invoices in the fleet site: WARN while overdue, CRIT once past the box's grace."""
    r = (catalog.get("_receivables") or {}).get(box["id"])
    if not r or box["owner"] == "self":
        return
    res["outstanding"], res["overdue_days"], res["oldest_due"] = r.get("outstanding", 0), int(r.get("overdue_days") or 0), r.get("oldest_due")
    if res["overdue_days"] <= 0:
        return
    amount = f"{float(r.get('outstanding') or 0):,.0f} {r.get('currency') or ''}".strip()
    grace = int(box.get("grace_days") or 0)
    if res["overdue_days"] > grace:
        f("CRIT", "unpaid", f"unpaid {res['overdue_days']} d past due ({amount}, {r.get('invoices', 0)} invoice(s)); grace of {grace} d is over: fleet dunning --apply")
    else:
        f("WARN", "unpaid", f"invoice overdue {res['overdue_days']} d ({amount}); grace ends in {grace - res['overdue_days']} d")


def check_box(box: dict, inv: dict, catalog: dict) -> dict:
    if box["mode"] == "push":
        rep = latest_report(box)
        raw: dict = {}
        if rep is None:
            raw["report_error"] = "fleet site not configured on the hub (no /etc/iiab/fleet.conf)"
        elif rep.get("error"):
            raw["report_error"] = f"fleet site unreachable: {rep['error'][:80]}"
        elif not rep.get("checked_at"):
            raw["stale_h"] = 10 ** 6
        else:
            raw = dict(rep.get("raw") or {})
            when = dt.datetime.fromisoformat(str(rep["checked_at"]).replace("Z", "+00:00"))
            if when.tzinfo is None:
                when = when.replace(tzinfo=dt.timezone.utc)
            raw["stale_h"] = (dt.datetime.now(dt.timezone.utc) - when).total_seconds() / 3600
            raw["report_checked_at"] = rep["checked_at"]
        return evaluate(box, raw, inv, catalog)
    return evaluate(box, collect_pull(box, catalog), inv, catalog)


# ----------------------------------------------------------------------------- state, digest, monitors


def write_check(res: dict) -> None:
    d = STATE / "checks" / res["id"]
    d.mkdir(parents=True, exist_ok=True)
    stamp = res["checked_at"].replace(":", "").replace("-", "")
    (d / f"{stamp}.json").write_text(json.dumps(res, indent=1))
    (d / "latest.json").write_text(json.dumps(res, indent=1))
    for p in sorted(p for p in d.glob("*.json") if p.name != "latest.json")[:-KEEP_CHECKS]:
        p.unlink()


def latest_checks(inv: dict) -> dict[str, dict]:
    out = {}
    for b in inv["boxes"]:
        p = STATE / "checks" / b["id"] / "latest.json"
        if p.exists():
            out[b["id"]] = json.loads(p.read_text())
    return out


def fmt_days(v) -> str:
    return "?" if v is None else f"{v}d"


def fmt_age(h) -> str:
    if h in (None, "?", ""):
        return "?"
    h = float(h)
    return f"{h:.0f}h" if h < 48 else f"{h / 24:.1f}d"


def build_digest(inv: dict, checks: dict[str, dict]) -> str:
    tz = ZoneInfo(inv["defaults"].get("timezone") or "UTC")
    now = dt.datetime.now(tz).strftime("%a %d %b %H:%M")
    counts = {s: sum(1 for c in checks.values() if c.get("status") == s) for s in ("OK", "WARN", "STALE", "CRIT")}
    lines = [f"Fleet {now}: " + ", ".join(f"{v} {k.lower()}" for k, v in counts.items() if v) + f" of {len(inv['boxes'])}",
             f"Release: {inv.get('current_release') or 'none'}"]
    for b in sorted(inv["boxes"], key=lambda b: (b["canary_rank"], b["id"])):
        c = checks.get(b["id"])
        if not c:
            lines.append(f"- ?? {label(b)}: never checked")
            continue
        mark = {"OK": "OK  ", "WARN": "WARN", "STALE": "STAL", "CRIT": "CRIT"}[c["status"]]
        bits = [f"disk {c.get('disk_free_gb', '?')}G", f"bak {fmt_age(c.get('hub_backup_age_h') if b['mode'] == 'pull' else c.get('box_backup_age_h'))}",
                f"err {c.get('errorlog_rows_today', '?')}"]
        if b["role"] == "till" and c.get("open_shifts") not in ("?", None):
            bits.append(f"shifts {c['open_shifts']}")
        if "hospitality" in (b.get("services") or []) and c.get("hotel_business_date"):
            bits.append(f"day {str(c['hotel_business_date'])[:10]}")
        if c.get("tls_days_left") is not None:
            bits.append(f"tls {c['tls_days_left']}d")
        if c.get("domain_days_left") is not None and c["domain_days_left"] < 90:
            bits.append(f"domain {c['domain_days_left']}d")
        if b["mode"] == "push":
            bits.append(f"reported {fmt_age(c.get('stale_h'))} ago")
        if b["status"] != "active":
            bits.append(b["status"].upper())
        lines.append(f"- {mark} {label(b)} ({b['business']}): " + ", ".join(bits))
        for x in c.get("findings", []):
            if x["level"] != "INFO" or x["code"] == "rebooted":
                lines.append(f"    · {x['level']}: {x['message']}")
    return "\n".join(lines)


def push_token_for(box_id: str, master: str) -> str:
    return hmac.new(master.encode(), f"box:{box_id}".encode(), hashlib.sha256).hexdigest()[:32]


def kuma_push(url: str, token: str, status: str, msg: str) -> None:
    try:
        import requests
        requests.get(f"{url.rstrip('/')}/api/push/{token}", params={"status": status, "msg": msg[:250]}, timeout=10)
    except Exception as e:
        print(f"kuma push: {e}")


def kuma_heartbeats(results: dict[str, dict], all_checks: dict[str, dict], whole_fleet: bool) -> None:
    conf = read_conf(PUSH_CONF)
    url, master = conf.get("KUMA_URL"), conf.get("KUMA_PUSH_TOKEN")
    if not (url and master):
        return
    for bid, c in results.items():
        down = c["status"] in ("CRIT", "STALE")
        first = next((x["message"] for x in c.get("findings", []) if x["level"] in ("CRIT", "STALE")), None)
        kuma_push(url, push_token_for(bid, master), "down" if down else "up", f"{c['status']}: {first}" if first else c["status"])
    if whole_fleet:
        bad = [i for i, c in all_checks.items() if c.get("status") in ("CRIT", "STALE")]
        kuma_push(url, master, "up", ("CRIT/STALE: " + ", ".join(bad)) if bad else "CHECK-OK")


def _set_backup_box(inv: dict) -> None:
    global _BACKUP_BOX
    bid = inv.get("backup_mail_box")
    _BACKUP_BOX = next((b for b in inv["boxes"] if b["id"] == bid and not b.get("local")), None) if bid else None


def cmd_check(a, inv):
    catalog = load_catalog()
    _set_backup_box(inv)
    catalog["_receivables"] = site_get("fleet_ops.api.receivables") or {}
    wd_id = inv.get("hub_watchdog_box")
    if wd_id:
        catalog["_watchdog_box"] = next((b for b in inv["boxes"] if b["id"] == wd_id), None)
    boxes = select_boxes(inv, a.ids, a.all)
    results = {}
    with cf.ThreadPoolExecutor(max_workers=6) as ex:
        futs = {ex.submit(check_box, b, inv, catalog): b for b in boxes}
        for fu in cf.as_completed(futs):
            r = fu.result()
            results[r["id"]] = r
            write_check(r)
    for b in boxes:
        r = results[b["id"]]
        print(f"== {label(b)} {b['host']} [{b['connectivity']}/{b['mode']}] {state(r['status'])}")
        if r.get("heads"):
            print("   " + " ".join(f"{k}={v[:7]}" for k, v in sorted(r["heads"].items())))
        if r.get("http"):
            print("   " + " ".join(f"{p}={c}" for p, c in r["http"].items()))
        print(f"   disk {r.get('disk_free_gb', '?')}G ram {r.get('ram_avail_mb', '?')}M err {r.get('errorlog_rows_today', '?')} shifts {r.get('open_shifts', '?')}"
              f" bak hub {fmt_age(r.get('hub_backup_age_h'))} box {fmt_age(r.get('box_backup_age_h'))} tls {fmt_days(r.get('tls_days_left'))}"
              f" domain {fmt_days(r.get('domain_days_left'))} ({r.get('domain_registrar') or '?'})")
        for x in r.get("findings", []):
            print(f"   {state(x['level'], 5)} {x['message']}")
    apply_dunning(inv, results, apply=bool(inv.get("auto_suspend")))
    all_checks = latest_checks(inv)
    (STATE / "latest-digest.txt").write_text(build_digest(inv, all_checks) + "\n")
    os.chmod(STATE / "latest-digest.txt", 0o644)
    if not a.no_push:
        push(inv, quiet=True)
    kuma_heartbeats(results, all_checks, whole_fleet=a.all)
    bad = [r["id"] for r in results.values() if r["status"] in ("CRIT", "STALE")]
    warn = [r["id"] for r in results.values() if r["status"] == "WARN"]
    print(paint(f"CHECK-{'FAILED ' + ','.join(bad) if bad else 'OK'}", "red" if bad else "green")
          + ((" (warnings: " + ",".join(warn) + ")") if warn else ""))
    return 1 if bad else 0


def cmd_digest(a, inv):
    p = STATE / "latest-digest.txt"
    if not p.exists():
        sys.exit("fleet: no digest yet (run `fleet check --all`)")
    print(p.read_text(), end="")
    if a.send:
        text = p.read_text().strip()
        if Path("/etc/systemd/system/fleet-digest.service").exists() and Path("/opt/iiab/ai-gateway/.venv").exists():
            subprocess.run(["systemctl", "start", "fleet-digest.service"], check=False)
            print("(handed to fleet-digest.service: the gateway's admin notification)")
        else:
            conf = load_push_conf()
            if not conf:
                print("(no delivery path: no gateway here and no fleet site configured)")
                return 1
            import requests
            try:
                r = requests.post(f"{conf['FLEET_SITE_URL'].rstrip('/')}/api/method/fleet_ops.api.notify",
                                  json={"subject": "Fleet digest: " + text.splitlines()[0], "text": text, **({"to": conf["DIGEST_TO"]} if conf.get("DIGEST_TO") else {})},
                                  headers={"Authorization": f"token {conf['FLEET_API_KEY']}:{conf['FLEET_API_SECRET']}", "Host": conf["FLEET_SITE_NAME"],
                                           "X-Frappe-Site-Name": conf["FLEET_SITE_NAME"]}, timeout=60)
                r.raise_for_status()
                print(f"(sent through the fleet site: {r.json().get('message')})")
            except Exception as e:
                print(f"(fleet site mail failed: {e})")
                return 1
    return 0


def cmd_status(a, inv):
    checks = latest_checks(inv)
    print(f"release: {inv.get('current_release') or 'none'}   inventory: {INVENTORY}   catalog: {CATALOG}")
    print(f"{'id':<8} {'alias':<17} {'host':<22} {'role':<9} {'conn':<8} {'status':<10} {'check':<6} {'when':<17} findings")
    for b in sorted(inv["boxes"], key=lambda b: (b["canary_rank"], b["id"])):
        c = checks.get(b["id"], {})
        when = c.get("checked_at", "-")[:16].replace("T", " ")
        fx = "; ".join(f"{x['level']} {x['message']}" for x in c.get("findings", []) if x["level"] != "INFO") or "-"
        print(f"{b['id']:<8} {b['alias']:<17} {b['host']:<22} {b['role']:<9} {b['connectivity']:<8} {b['status']:<10} {state(c.get('status', '-'), 6)} {when:<17} {fx}")
    return 0


def cmd_tailnet(a, inv):
    """Our machines as the tailnet sees them from this hub: which inventory box each node is,
    online or last seen, OS, relay, tag. The iiab-vpn peer table, keyed by box."""
    r = subprocess.run(["tailscale", "status", "--json"], capture_output=True, text=True)
    if r.returncode != 0:
        sys.exit("fleet: tailscale status failed: " + (r.stderr.strip() or r.stdout.strip())[-200:])
    d = json.loads(r.stdout)
    nodes = [d["Self"]] + list((d.get("Peer") or {}).values())
    by_ip, by_name = {}, {b["id"]: b for b in inv["boxes"]}
    for b in inv["boxes"]:
        for addr in (b["host"], (b.get("reach") or {}).get("ssh", ""), (b.get("reach") or {}).get("http", "")):
            addr = re.sub(r"^https?://", "", addr or "").split("/")[0].split(":")[0]
            if addr:
                by_ip[addr] = b

    def root(tag: str) -> str:            # tag:blondel-ephem -> blondel
        return tag.split(":", 1)[-1].split("-")[0]
    rows, ours = [], {root(t) for t in d["Self"].get("Tags") or []}
    for n in nodes:
        ips = n.get("TailscaleIPs") or []
        box = by_name.get(n.get("HostName")) or next((by_ip[i] for i in ips if i in by_ip), None)
        if box:
            ours |= {root(t) for t in n.get("Tags") or []}
        rows.append((n, box))
    mine = [(n, b) for n, b in rows if b or ({root(t) for t in n.get("Tags") or []} & ours)]
    print(f"{'node':<20} {'address':<13} {'box':<24} {'state':<8} {'last seen':<17} {'os':<8} {'relay':<6} tag")
    for n, b in sorted(mine, key=lambda t: (t[1] is None, (t[1] or {}).get("id", ""), t[0].get("HostName", ""))):
        online = bool(n.get("Online"))
        last = "" if online else (n.get("LastSeen") or "")[:16].replace("T", " ")
        tag = ",".join(t.replace("tag:", "") for t in n.get("Tags") or []) or "-"
        print(f"{n.get('HostName', '?'):<20} {(n.get('TailscaleIPs') or ['?'])[0]:<13} {(label(b) if b else '-'):<24} "
              f"{paint(f'{'online' if online else 'offline':<8}', 'green' if online else 'red')} {last:<17} {n.get('OS', '?'):<8} {n.get('Relay') or '-':<6} {tag}")
    seen = {b["id"] for _, b in mine if b}
    missing = [b for b in inv["boxes"] if b["id"] not in seen and b.get("connectivity") == "tailnet"]
    if missing:
        print(paint("not on the tailnet: " + ", ".join(label(b) for b in missing), "red"))
    unnamed = [n.get("HostName") for n, b in mine if not b and (n.get("OS") == "linux")]
    others = len(rows) - len(mine)
    print(f"\n{others} other members' nodes not shown." + (f"  Linux nodes under our tag without a box record: {', '.join(unnamed)} (fleet hostname <id> names a box's node; tailscale logout retires a stray one)" if unnamed else ""))
    print("Check a node: tailscale ping <address>   tailscale whois <address>   Undo a join: tailscale logout (on that machine)")
    return 0


def cmd_list(a, inv):
    print(f"{'rank':<4} {'id':<8} {'alias':<17} {'host':<22} {'business':<24} {'role':<9} {'owner':<9} {'conn':<8} {'plan':<10} {'status':<10} services")
    for b in sorted(inv["boxes"], key=lambda b: (b["canary_rank"], b["id"])):
        print(f"{b['canary_rank']:<4} {b['id']:<8} {b['alias']:<17} {b['host']:<22} {b['business']:<24} {b['role']:<9} {b['owner']:<9} {b['connectivity']:<8} {b.get('plan', ''):<10} {b['status']:<10} {','.join(b['services'])}")
    return 0


# ----------------------------------------------------------------------------- upgrade


def in_window(box: dict) -> bool:
    m = re.fullmatch(r"(\d\d):(\d\d)-(\d\d):(\d\d)", box.get("maintenance_window") or "")
    if not m:
        return True
    now = dt.datetime.now(ZoneInfo(box.get("timezone") or "UTC")).time()
    start, end = dt.time(int(m[1]), int(m[2])), dt.time(int(m[3]), int(m[4]))
    return start <= now <= end if start <= end else (now >= start or now <= end)


def log_action(text: str) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "actions.log", "a") as fh:
        fh.write(f"{dt.datetime.now(dt.timezone.utc).isoformat(timespec='seconds')} {text}\n")


def box_log(box: dict, prefix: str) -> tuple[str, int]:
    """The log a bench script will write on this box today, and how long it already is.

    The scripts name their log by the box's own date, which is not the hub's date for part of
    every day (Haiti and Berlin differ by six hours), and a second run on the same day appends to
    the same file. Following the hub's guess once read yesterday's UPGRADE-OK off the wrong file
    and declared a box done while its services were still stopped. So: ask the box for the date,
    and read only the lines written after the run starts."""
    rc, out = run_on(box, "date +%F")
    today = out.strip() if rc == 0 and re.fullmatch(r"\d{4}-\d{2}-\d{2}", out.strip()) else f"{dt.date.today():%Y-%m-%d}"
    log = f"/root/{prefix}-{today}.log"
    rc, out = run_on(box, f"wc -l < {log} 2>/dev/null || echo 0")
    start = int(out.strip()) if rc == 0 and out.strip().isdigit() else 0
    return log, start


def upgrade_box(box: dict, rid: str | None, preflight: bool, allow_discard: str | None) -> bool:
    if not UPGRADE_SCRIPT.exists():
        sys.exit(f"fleet: {UPGRADE_SCRIPT} missing")
    scp_to(box, UPGRADE_SCRIPT, "/root/bench-upgrade.sh")
    env = []
    if rid:
        scp_to(box, manifest_path(rid), "/root/bench-upgrade.manifest", "0644")
        env.append("--setenv=MANIFEST=/root/bench-upgrade.manifest")
    if preflight:
        env.append("--setenv=PREFLIGHT_ONLY=1")
    if allow_discard:
        env.append(f"--setenv=ALLOW_DISCARD={allow_discard}")
    unit = f"bench-upgrade-{int(time.time())}"
    log, start = box_log(box, "bench-upgrade")
    rc, out = run_on(box, f"systemd-run --unit={unit} --collect --setenv=HOME=/root {' '.join(env)} /bin/bash /root/bench-upgrade.sh")
    if rc != 0:
        print(f"   could not start the upgrade unit: {out}")
        return False
    print(f"   started {unit}; log {log}")
    deadline, last = time.time() + 3600, ""
    while time.time() < deadline:
        time.sleep(20)
        rc, out = run_on(box, f"tail -n +{start + 1} {log} 2>/dev/null | tail -n 3")
        tail = out.splitlines()[-1] if out else ""
        if tail != last:
            print(f"   {tail}")
            last = tail
        if any(l.startswith(("UPGRADE-OK", "UPGRADE-FAILED", "PREFLIGHT-OK")) for l in out.splitlines()):
            return any(l.startswith(("UPGRADE-OK", "PREFLIGHT-OK")) for l in out.splitlines())
    print("   timed out after 60 minutes")
    return False


def cmd_upgrade(a, inv):
    catalog = load_catalog()
    boxes = select_boxes(inv, a.ids, a.all)
    rid = a.release or inv.get("current_release") or None
    if rid:
        read_manifest(rid)
    print(f"upgrade {'(preflight) ' if a.preflight else ''}order: {', '.join(b['id'] for b in boxes)}; release: {rid or 'fork heads'}")
    for b in boxes:
        if b["mode"] == "push":
            print(f"== {b['id']}: offline box; fleet-agent applies release {rid or '(none)'} itself inside its window")
            continue
        if b["status"] in ("suspended", "offboarded") and not a.now:
            print(f"== {b['id']}: skipped ({b['status']})")
            continue
        if not a.preflight and not a.now and not in_window(b):
            print(f"== {b['id']}: outside its maintenance window {b.get('maintenance_window')} ({b.get('timezone')}); use --now")
            return 1
        print(f"== {b['id']} {b['host']}")
        ok = upgrade_box(b, rid, a.preflight, a.allow_discard)
        log_action(f"upgrade {b['id']} release={rid} preflight={a.preflight} result={'ok' if ok else 'FAILED'}")
        if not ok:
            print(f"UPGRADE-FAILED {b['id']} — stopping the rollout")
            return 1
        if not a.preflight:
            r = check_box(b, inv, catalog)
            write_check(r)
            if r["status"] in ("CRIT", "STALE"):
                print(f"   post-upgrade check {r['status']}: {'; '.join(r['problems'])} — stopping the rollout")
                return 1
            print(f"   post-upgrade check {r['status']}")
    print("UPGRADE-OK" if not a.preflight else "PREFLIGHT-OK")
    return 0


# ----------------------------------------------------------------------------- backup-pull


def cmd_rollback(a, inv):
    """Undo the box's last upgrade (bench-rollback.sh on the box, followed like an upgrade)."""
    box = select_boxes(inv, [a.id], False)[0]
    if box["mode"] == "push":
        sys.exit("fleet: an offline box rolls back from its own console (bench-rollback.sh on the box)")
    if not (a.dry_run or a.now or in_window(box)):
        sys.exit(f"fleet: {label(box)} is outside its maintenance window {box.get('maintenance_window')} ({box.get('timezone')}); use --now")
    if not ROLLBACK_SCRIPT.exists():
        sys.exit(f"fleet: {ROLLBACK_SCRIPT} missing")
    scp_to(box, ROLLBACK_SCRIPT, "/root/bench-rollback.sh")
    env = []
    if a.release:
        read_manifest(a.release)
        scp_to(box, manifest_path(a.release), "/root/bench-rollback.manifest", "0644")
        env.append("--setenv=MANIFEST=/root/bench-rollback.manifest")
    if a.no_restore:
        env.append("--setenv=RESTORE=0")
    if a.dry_run:
        rc, out = run_on(box, f"DRY_RUN=1 {' '.join(e.replace('--setenv=', '') for e in env)} /bin/bash /root/bench-rollback.sh", timeout=120)
        print(out[-1500:])
        return 0 if "ROLLBACK-PLAN-OK" in out else 1
    print(f"== {label(box)} {box['host']}: rollback {'to release ' + a.release if a.release else 'of the last upgrade'}{' (code only)' if a.no_restore else ''}")
    unit = f"bench-rollback-{int(time.time())}"
    log, start = box_log(box, "bench-rollback")
    rc, out = run_on(box, f"systemd-run --unit={unit} --collect --setenv=HOME=/root {' '.join(env)} /bin/bash /root/bench-rollback.sh")
    if rc != 0:
        print(f"   could not start the rollback unit: {out}")
        return 1
    print(f"   started {unit}; log {log}")
    deadline, last, ok = time.time() + 3600, "", None
    while time.time() < deadline:
        time.sleep(20)
        rc, out = run_on(box, f"tail -n +{start + 1} {log} 2>/dev/null | tail -n 3")
        tail = out.splitlines()[-1] if out else ""
        if tail != last:
            print(f"   {tail}")
            last = tail
        if any(l.startswith(("ROLLBACK-OK", "ROLLBACK-FAILED")) for l in out.splitlines()):
            ok = any(l.startswith("ROLLBACK-OK") for l in out.splitlines())
            break
    if ok is None:
        print("   timed out after 60 minutes")
        return 1
    log_action(f"rollback {box['id']} release={a.release or 'last-upgrade'} restore={not a.no_restore} result={'ok' if ok else 'FAILED'}")
    if ok:
        r = check_box(box, inv, load_catalog())
        write_check(r)
        print(f"   post-rollback check {r['status']}: " + ("; ".join(x["message"] for x in r["findings"] if x["level"] != "INFO") or "clean"))
        push(inv, quiet=True)
    return 0 if ok else 1


def cmd_backup_pull(a, inv):
    """Mirror /library/backups/fleet from the box that runs fleet-backup-mail onto this hub,
    so the fleet's backups also sit on hardware we own. Keeps what the source keeps."""
    _set_backup_box(inv)
    if not _BACKUP_BOX:
        sys.exit("fleet: set backup_mail_box in the inventory to the box running fleet-backup-mail (not this machine)")
    dest = Path(a.dest or str(HUB_BACKUPS))
    dest.mkdir(parents=True, exist_ok=True, mode=0o700)
    src = f"{_BACKUP_BOX['ssh_user']}@{_BACKUP_BOX['reach']['ssh']}:{HUB_BACKUPS}/"
    r = subprocess.run(["rsync", "-a", "--delete", "-e", "ssh -o BatchMode=yes", src, str(dest) + "/"], capture_output=True, text=True)
    print(r.stderr.strip()[-300:] if r.returncode else f"backup copies mirrored from {_BACKUP_BOX['id']} to {dest}")
    log_action(f"backup-pull from={_BACKUP_BOX['id']} rc={r.returncode}")
    if r.returncode == 0:
        hub = next((b for b in inv["boxes"] if b.get("local")), None)
        print(f"Check: ls {dest}" + (f"; fleet check {hub['id']}  (its 'bak hub' age reads this mirror)" if hub else ""))
    return r.returncode


# ----------------------------------------------------------------------------- reboot


def cmd_reboot(a, inv):
    """Reboot a box inside its maintenance window (or --now), then wait for it and re-check.
    Tills: the POS keeps selling offline in the browser during the two minutes a reboot takes.
    --all: every remote pull-mode box in canary order, stopping at the first failure."""
    catalog = load_catalog()
    if getattr(a, "all", False):
        rc = 0
        for b in select_boxes(inv, [], True):
            if b.get("local") or b["mode"] == "push" or b["status"] in ("suspended", "offboarded"):
                continue
            sub = argparse.Namespace(id=b["id"], now=a.now, all=False)
            rc = cmd_reboot(sub, inv)
            if rc:
                print(f"stopping after {b['id']}")
                return rc
        return rc
    box = select_boxes(inv, [a.id], False)[0]
    if box["mode"] == "push":
        sys.exit("fleet: offline box; reboot it on site")
    if not a.now and not in_window(box):
        sys.exit(f"fleet: outside the maintenance window {box.get('maintenance_window')} ({box.get('timezone')}); use --now")
    print(f"== {box['id']}: rebooting")
    log_action(f"reboot {box['id']} now={a.now}")
    run_on(box, "systemd-run --on-active=2 --collect /bin/systemctl reboot", timeout=30)
    time.sleep(30)
    for i in range(40):
        code = http_code(f"{box['reach']['http']}/erp/api/method/ping", timeout=10)
        if code == "200":
            print(f"   back after ~{30 + i * 10}s")
            break
        time.sleep(10)
    else:
        print("   no answer after 7 minutes")
        return 1
    r = check_box(box, inv, catalog)
    write_check(r)
    print(f"   post-reboot check {r['status']}: " + ("; ".join(x["message"] for x in r["findings"] if x["level"] != "INFO") or "clean"))
    push(inv, quiet=True)
    return 0 if r["status"] not in ("CRIT", "STALE") else 1


# ----------------------------------------------------------------------------- lifecycle


def set_status(inv: dict, box: dict, status: str) -> None:
    for b in inv["boxes"]:
        if b["id"] == box["id"]:
            b["status"] = status
    save_inventory(inv)


def set_field(inv: dict, box: dict, key: str, value) -> None:
    for b in inv["boxes"]:
        if b["id"] == box["id"]:
            if value is None:
                b.pop(key, None)
            else:
                b[key] = value
    save_inventory(inv)


def maintenance_reload(box: dict) -> str:
    """gunicorn workers cache the site config: after flipping maintenance_mode, clear the cache
    and restart the web service (about ten seconds) or some workers keep answering the old way."""
    return bench(box, f"--site {box['site']} clear-cache") + " >/dev/null; systemctl restart frappe-bench-frappe-web.service"


def suspend_box(inv: dict, box: dict, reason: str, cause: str | None = None) -> tuple[bool, str]:
    """Maintenance page on, status suspended. cause='unpaid' marks an automatic suspension so a payment can lift it."""
    if box["owner"] == "self":
        return False, "refusing to suspend one of our own boxes"
    if box["mode"] == "push":
        return False, "an offline box cannot be suspended from the hub (the agent does not apply status yet)"
    rc, out = run_on(box, bench(box, f"--site {box['site']} set-maintenance-mode on") + " && " + maintenance_reload(box))
    if rc != 0:
        return False, out[-300:]
    set_status(inv, box, "suspended")
    set_field(inv, box, "suspended_for", cause)
    log_action(f"suspend {box['id']} reason={reason!r} cause={cause or 'operator'}")
    return True, f"{label(box)} suspended (maintenance page on). Reason: {reason or '-'}"


def resume_box(inv: dict, box: dict, why: str = "") -> tuple[bool, str]:
    rc, out = run_on(box, bench(box, f"--site {box['site']} set-maintenance-mode off") + " && " + maintenance_reload(box))
    if rc != 0:
        return False, out[-300:]
    set_status(inv, box, "active")
    set_field(inv, box, "suspended_for", None)
    log_action(f"resume {box['id']} {why}".rstrip())
    return True, f"{label(box)} resumed"


def cmd_suspend(a, inv):
    box = select_boxes(inv, [a.id], False)[0]
    ok, msg = suspend_box(inv, box, a.reason)
    print(msg)
    if ok:
        push(inv, quiet=True)
        print(f"Check: {box['reach']['http']}/ shows the maintenance page\nUndo:  fleet resume {box['id']}")
    return 0 if ok else 1


def cmd_resume(a, inv):
    box = select_boxes(inv, [a.id], False)[0]
    ok, msg = resume_box(inv, box)
    print(msg)
    if ok:
        push(inv, quiet=True)
        print(f"Check: fleet check {box['id']}")
    return 0 if ok else 1


def apply_dunning(inv: dict, results: dict[str, dict], apply: bool, quiet: bool = True) -> list[str]:
    """Status follows the money: active -> grace while an invoice is overdue, back to active when
    paid; past the grace, suspend when apply is on (auto_suspend in the inventory, or --apply),
    and lift an automatic suspension once paid. Returns the human lines."""
    lines = []
    for b in list(inv["boxes"]):
        r = results.get(b["id"])
        if not r or b["owner"] == "self" or b["status"] == "offboarded":
            continue
        days = int(r.get("overdue_days") or 0)
        grace = int(b.get("grace_days") or 0)
        if days > 0 and b["status"] == "active":
            set_status(inv, b, "grace"); log_action(f"dunning {b['id']} -> grace ({days} d overdue)")
            lines.append(f"{label(b)}: overdue {days} d -> grace")
        elif days == 0 and b["status"] == "grace":
            set_status(inv, b, "active"); log_action(f"dunning {b['id']} -> active (paid)")
            lines.append(f"{label(b)}: paid -> active")
        elif days == 0 and b["status"] == "suspended" and b.get("suspended_for") == "unpaid":
            if apply:
                ok, msg = resume_box(inv, b, "(paid; automatic)")
                lines.append(f"{label(b)}: paid -> {msg if ok else 'resume FAILED ' + msg}")
            else:
                lines.append(f"{label(b)}: paid; was suspended for non-payment: fleet resume {b['id']}")
        if days > grace and b["status"] in ("active", "grace"):
            if apply:
                ok, msg = suspend_box(inv, b, f"unpaid {days} d past due, grace {grace} d", cause="unpaid")
                lines.append(f"{label(b)}: {msg if ok else 'suspend FAILED ' + msg}")
            else:
                lines.append(f"{label(b)}: {days} d past due, grace {grace} d over -> would suspend (fleet dunning --apply)")
    if not quiet:
        print("\n".join(lines) if lines else "nothing overdue")
    return lines


def cmd_dunning(a, inv):
    catalog = {"_receivables": site_get("fleet_ops.api.receivables") or {}}
    if not catalog["_receivables"]:
        print("no receivables (fleet site unreachable, or no invoices)")
    results = {}
    for b in inv["boxes"]:
        res = {"findings": []}
        judge_receivables(b, res, catalog, lambda level, code, msg: res["findings"].append({"level": level, "code": code, "message": msg}))
        results[b["id"]] = res
        if res["findings"]:
            print(f"{label(b)}: {res['findings'][0]['message']}")
    lines = apply_dunning(inv, results, apply=a.apply, quiet=True)
    print("\n".join(lines) if lines else "nothing to change")
    if a.apply:
        push(inv, quiet=True)
    return 0


def cmd_offboard(a, inv):
    box = select_boxes(inv, [a.id], False)[0]
    if box["owner"] == "self":
        sys.exit("fleet: refusing to offboard one of our own boxes")
    stamp = dt.datetime.now(dt.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    dest = Path("/library/backups/offboard") / box["id"] / stamp
    dest.mkdir(parents=True, exist_ok=True)
    print(f"== {box['id']}: final backup with files")
    rc, out = run_on(box, bench(box, f"--site {box['site']} backup --with-files"), timeout=1800)
    if rc != 0:
        print(out)
        return 1
    bdir = f"{box['bench']}/sites/{box['site']}/private/backups/"
    src = bdir if box.get("local") else f"{box['ssh_user']}@{box['reach']['ssh']}:{bdir}"
    subprocess.run(["rsync", "-a", "-e", "ssh -o BatchMode=yes", src, str(dest)], check=True)
    (dest / "HANDOVER.txt").write_text(
        f"Offboarding backup for {box['business']} ({box['host']}) taken {stamp}.\n"
        "Contents: the newest *-database.sql.gz, *-files.tar, *-private-files.tar and the site_config backup.\n"
        "Restore on any Frappe bench with the same app set:\n"
        "  bench new-site <site> ; bench --site <site> restore <db>.sql.gz --with-public-files <files.tar> --with-private-files <private.tar>\n"
        "Hand this folder to the customer on the medium agreed in the contract.\n")
    set_status(inv, box, "offboarded")
    log_action(f"offboard {box['id']} backup={dest}")
    print(f"backup at {dest}\n{box['id']} marked offboarded in the inventory.")
    print("Wipe is a manual step after the customer confirms receipt in writing:\n"
          f"  ssh {box['ssh_user']}@{box['reach']['ssh']} \"sudo -u frappe -H bash -lc 'cd {box['bench']} && bench drop-site {box['site']} --force'\"\n"
          "  then remove the box from /etc/iiab/fleet.yml and /etc/iiab/fleet-backup.conf, and its monitors.")
    push(inv, quiet=True)
    return 0


# ----------------------------------------------------------------------------- agent + watchdog deployment


def agent_secret() -> str:
    conf = read_conf(PUSH_CONF)
    s = conf.get("FLEET_AGENT_SECRET")
    if not s:
        import secrets
        s = secrets.token_hex(32)
        set_conf(PUSH_CONF, "FLEET_AGENT_SECRET", s)
    return s


def agent_token_for(box_id: str) -> str:
    return hmac.new(agent_secret().encode(), f"agent:{box_id}".encode(), hashlib.sha256).hexdigest()[:40]


def agent_conf_text(box: dict) -> str:
    conf = read_conf(PUSH_CONF)
    hub = conf.get("FLEET_PUBLIC_URL") or sys.exit("fleet: FLEET_PUBLIC_URL is not set in the fleet configuration")
    kuma = f"{conf['KUMA_URL'].rstrip('/')}/api/push/{push_token_for(box['id'], conf['KUMA_PUSH_TOKEN'])}" if conf.get("KUMA_URL") and conf.get("KUMA_PUSH_TOKEN") else ""
    return (f"# fleet-agent configuration for {box['id']} (0600). Reports go to the fleet site on the hub.\n"
            f"FLEET_BOX_ID={box['id']}\nFLEET_HUB_URL={hub}\nFLEET_AGENT_TOKEN={agent_token_for(box['id'])}\n"
            f"KUMA_PUSH_URL={kuma}\nSITE={box['site']}\nBENCH={box['bench']}\nMAINTENANCE_WINDOW={box.get('maintenance_window', '')}\nTIMEZONE={box.get('timezone', 'UTC')}\n")


def cmd_agent_token(a, inv):
    box = select_boxes(inv, [a.id], False)[0]
    print(agent_conf_text(box), end="")
    return 0


def cmd_deploy_agent(a, inv):
    box = select_boxes(inv, [a.id], False)[0]
    units = SCRIPTS / "fleet-units"
    tmp = STATE / f"agent-{box['id']}.conf"
    tmp.write_text(agent_conf_text(box))
    os.chmod(tmp, 0o600)
    scp_to(box, SCRIPTS / "fleet-agent", "/usr/local/sbin/fleet-agent")
    scp_to(box, UPGRADE_SCRIPT, "/root/bench-upgrade.sh")
    scp_to(box, tmp, "/etc/iiab/fleet-agent.conf", "0600")
    for u in ("fleet-agent.service", "fleet-agent.timer", "fleet-agent-upgrade.service", "fleet-agent-upgrade.timer"):
        scp_to(box, units / u, f"/etc/systemd/system/{u}", "0644")
    rc, out = run_on(box, "systemctl daemon-reload && systemctl enable --now fleet-agent.timer fleet-agent-upgrade.timer && /usr/local/sbin/fleet-agent report")
    tmp.unlink(missing_ok=True)
    print(out[-800:])
    log_action(f"deploy-agent {box['id']} rc={rc}")
    push(inv, quiet=True)
    if rc == 0:
        print(f"Check: fleet status  ({label(box)} reports within the hour; its push monitor in Uptime Kuma turns up)")
    return 0 if rc == 0 else 1


def cmd_deploy_watchdog(a, inv):
    box = select_boxes(inv, [a.id], False)[0]
    if box["role"] == "hub":
        sys.exit("fleet: the hub watchdog must run on another box")
    hub = next(b for b in inv["boxes"] if b["role"] == "hub")
    units = SCRIPTS / "fleet-units"
    scp_to(box, SCRIPTS / "fleet-hub-watchdog", "/usr/local/sbin/fleet-hub-watchdog")
    for u in ("fleet-hub-watchdog.service", "fleet-hub-watchdog.timer"):
        scp_to(box, units / u, f"/etc/systemd/system/{u}", "0644")
    conf = (f"# Hub watchdog (0600). Fill the Contabo API credentials (Customer Control Panel -> API) to let it\n"
            f"# start the hub when Contabo reports it stopped. Without them it only logs.\n"
            f"HUB_PING_URL=https://{hub['host']}/erp/api/method/ping\nHUB_PUBLIC_HOST={hub['host']}\nFAIL_THRESHOLD=3\nCOOLDOWN_MIN=30\n"
            f"CONTABO_CLIENT_ID=\nCONTABO_CLIENT_SECRET=\nCONTABO_API_USER=\nCONTABO_API_PASSWORD=\nCONTABO_INSTANCE_ID=\n")
    tmp = STATE / f"watchdog-{box['id']}.conf"
    tmp.write_text(conf)
    os.chmod(tmp, 0o600)
    rc, out = run_on(box, "test -f /etc/iiab/fleet-hub-watchdog.conf && echo exists || echo new")
    if "exists" not in out:
        scp_to(box, tmp, "/etc/iiab/fleet-hub-watchdog.conf", "0600")
    tmp.unlink(missing_ok=True)
    rc, out = run_on(box, "mkdir -p /var/lib/fleet && systemctl daemon-reload && systemctl enable --now fleet-hub-watchdog.timer && /usr/local/sbin/fleet-hub-watchdog --once")
    print(out[-800:])
    log_action(f"deploy-watchdog {box['id']} rc={rc}")
    if rc == 0:
        inv["hub_watchdog_box"] = box["id"]
        save_inventory(inv)
        print(f"inventory: hub_watchdog_box = {box['id']} (the hub's check now reads its log)")
        print(f"Next:  on {label(box)}, fill /etc/iiab/fleet-hub-watchdog.conf with the Contabo API credentials; it only logs until then\n"
              f"Check: ssh {box['ssh_user']}@{box['reach']['ssh']} tail -n 5 /var/lib/fleet/hub-watchdog.log")
    return 0 if rc == 0 else 1


# ----------------------------------------------------------------------------- IIAB roles + local_vars store


def cmd_runrole(a, inv):
    """IIAB roles run on the box itself (`runrole` reads the box's /etc/iiab/local_vars.yml);
    the hub only starts the run and follows its log."""
    box = select_boxes(inv, [a.id], False)[0]
    if box["mode"] == "push":
        sys.exit("fleet: offline box; run the role on the box itself")
    if not re.fullmatch(r"[a-z0-9_-]+", a.role):
        sys.exit("fleet: role name must be a plain role directory name")
    log = f"/opt/iiab/iiab/fleet-runrole-{a.role}-{dt.datetime.now():%Y%m%d-%H%M%S}.log"
    if a.tags:
        cmd = (f"cd /opt/iiab/iiab && ANSIBLE_LOG_PATH={log} ansible-playbook -i ansible_hosts run-one-role.yml --connection=local "
               f"--extra-vars '{{\"role_to_run\":\"{a.role}\"}}' --tags {shlex.quote(a.tags)}")
    else:
        cmd = f"/opt/iiab/iiab/runrole {a.role} {log}"
    unit = f"fleet-runrole-{int(time.time())}"
    rc, out = run_on(box, f"systemd-run --unit={unit} --collect --setenv=HOME=/root /bin/bash -lc {shlex.quote(cmd)}")
    if rc != 0:
        print(out)
        return 1
    print(f"== {box['id']}: role {a.role}{' tags ' + a.tags if a.tags else ''} started ({unit}); log {log}")
    log_action(f"runrole {box['id']} role={a.role} tags={a.tags or '-'} log={log}")
    seen = 0
    for _ in range(360):                       # follow for up to 2 h
        time.sleep(20)
        rc, out = run_on(box, f"wc -l < {log} 2>/dev/null; systemctl is-active {unit} 2>/dev/null")
        parts = out.split()
        n = int(parts[0]) if parts and parts[0].isdigit() else 0
        active = parts[-1] if parts else "unknown"
        if n > seen:
            rc, chunk = run_on(box, f"sed -n '{seen + 1},{n}p' {log}")
            print(chunk)
            seen = n
        if active not in ("active", "activating"):
            rc, tail = run_on(box, f"tail -n 25 {log}")
            print(tail)
            ok = "failed=0" in tail and "unreachable=0" in tail
            print(f"RUNROLE-{'OK' if ok else 'FAILED'} {box['id']} {a.role}")
            return 0 if ok else 1
    print("still running after 2 h; follow the log on the box")
    return 1


def cmd_vars(a, inv):
    """Keep a private copy of every box's /etc/iiab/local_vars.yml on the hub (pull), show drift
    (diff). Pushing is deliberate and manual: `fleet vars show <id>` prints the path to copy."""
    store = Path("/etc/iiab/fleet-vars")
    store.mkdir(mode=0o700, exist_ok=True)
    boxes = select_boxes(inv, a.ids, a.all)
    rc_all = 0
    for b in boxes:
        f = store / f"{b['id']}.local_vars.yml"
        if a.action == "pull":
            rc, out = run_on(b, "cat /etc/iiab/local_vars.yml")
            if rc != 0 or not out:
                print(f"{b['id']}: could not read local_vars.yml")
                rc_all = 1
                continue
            changed = (not f.exists()) or f.read_text() != out + "\n"
            f.write_text(out + "\n")
            os.chmod(f, 0o600)
            print(f"{b['id']}: {'updated' if changed else 'unchanged'} -> {f}")
        elif a.action == "diff":
            if not f.exists():
                print(f"{b['id']}: no copy yet (fleet vars pull {b['id']})")
                continue
            rc, out = run_on(b, "cat /etc/iiab/local_vars.yml")
            import difflib
            d = list(difflib.unified_diff(f.read_text().splitlines(), (out + "\n").splitlines(), f"hub copy {b['id']}", f"box {b['id']}", lineterm=""))
            d = [l for l in d if not re.search(r"(password|secret|token|key)\s*:", l, re.I) or l.startswith(("---", "+++", "@@"))]
            print(f"== {b['id']}: {'in sync' if not d else str(len(d)) + ' diff lines (secret lines hidden)'}")
            for l in d[:60]:
                print("   " + l)
        elif a.action == "show":
            print(f"{b['id']}: {f if f.exists() else 'no copy yet'}")
    return rc_all


# ----------------------------------------------------------------------------- push (ERPNext mirror)


def load_push_conf() -> dict | None:
    conf = read_conf(PUSH_CONF)
    need = ("FLEET_SITE_URL", "FLEET_SITE_NAME", "FLEET_API_KEY", "FLEET_API_SECRET")
    return conf if all(conf.get(k) for k in need) else None


def push(inv: dict, quiet: bool = False) -> int:
    conf = load_push_conf()
    if not conf:
        if not quiet:
            print(f"push: {PUSH_CONF} missing or incomplete; nothing mirrored")
        return 0
    import requests
    s = requests.Session()
    s.headers.update({"Authorization": f"token {conf['FLEET_API_KEY']}:{conf['FLEET_API_SECRET']}",
                      "Host": conf["FLEET_SITE_NAME"], "X-Frappe-Site-Name": conf["FLEET_SITE_NAME"]})
    base = conf["FLEET_SITE_URL"].rstrip("/")
    checks = latest_checks(inv)
    catalog = load_catalog()
    releases = []
    for p in sorted(RELEASES.glob("*.manifest")):
        m = read_manifest(p.stem)
        releases.append({"release": p.stem, "captured": m.get("captured"), "notes": m.get("notes", ""), "apps": manifest_apps(m)})
    payload = {"current_release": inv.get("current_release") or "", "releases": releases, "boxes": [],
               "catalog": [{"service_id": k, **{kk: vv for kk, vv in v.items() if kk != "probes"}, "probes": json.dumps(v.get("probes") or v.get("hub_probes") or [])}
                           for k, v in catalog.get("services", {}).items()]}
    secret_present = bool(read_conf(PUSH_CONF).get("FLEET_AGENT_SECRET"))
    for b in inv["boxes"]:
        c = checks.get(b["id"])
        payload["boxes"].append({
            "box_id": b["id"], "alias": b["alias"], "host": b["host"], "business": b["business"], "role": b["role"], "owner": b["owner"],
            "profile": b.get("profile", ""), "plan": b.get("plan", ""), "status": b["status"], "canary_rank": b["canary_rank"],
            "timezone": b.get("timezone", ""), "maintenance_window": b.get("maintenance_window", ""),
            "connectivity": b["connectivity"], "services": b["services"],
            "billing_contact": (b.get("contacts") or {}).get("billing", ""), "technical_contact": (b.get("contacts") or {}).get("technical", ""),
            "agent_token_hash": hashlib.sha256(agent_token_for(b["id"]).encode()).hexdigest() if secret_present else "",
            "check": c})
    try:
        r = s.post(f"{base}/api/method/fleet_ops.api.sync", json=payload, timeout=90)
        r.raise_for_status()
        msg = r.json().get("message", {})
    except Exception as e:
        print(f"push: failed: {e}")
        return 1
    if not quiet:
        print(f"push: {msg}")
    return 0


def cmd_push(a, inv):
    return push(inv)


# ----------------------------------------------------------------------------- identity: onboard, rename, hostname


def site_call(method: str, payload: dict, timeout: int = 60) -> tuple[bool, object]:
    """POST a whitelisted fleet_ops method on the fleet site; (ok, message)."""
    conf = load_push_conf()
    if not conf:
        return False, f"{PUSH_CONF} missing or incomplete"
    import requests
    try:
        r = requests.post(f"{conf['FLEET_SITE_URL'].rstrip('/')}/api/method/{method}", json=payload, timeout=timeout,
                          headers={"Authorization": f"token {conf['FLEET_API_KEY']}:{conf['FLEET_API_SECRET']}",
                                   "Host": conf["FLEET_SITE_NAME"], "X-Frappe-Site-Name": conf["FLEET_SITE_NAME"]})
        r.raise_for_status()
        return True, r.json().get("message")
    except Exception as e:
        return False, str(e)


def site_get(method: str, params: dict | None = None, timeout: int = 60):
    """GET a whitelisted fleet_ops method on the fleet site; the message, or None when unreachable."""
    conf = load_push_conf()
    if not conf:
        return None
    import requests
    try:
        r = requests.get(f"{conf['FLEET_SITE_URL'].rstrip('/')}/api/method/{method}", params=params or {}, timeout=timeout,
                         headers={"Authorization": f"token {conf['FLEET_API_KEY']}:{conf['FLEET_API_SECRET']}",
                                  "Host": conf["FLEET_SITE_NAME"], "X-Frappe-Site-Name": conf["FLEET_SITE_NAME"]})
        r.raise_for_status()
        return r.json().get("message")
    except Exception as e:
        print(f"fleet site: {method} failed: {e}")
        return None


def kuma_seed_path() -> Path:
    for p in (Path("/usr/local/sbin/fleet-kuma-seed"), SCRIPTS / "fleet-kuma-seed"):
        if p.exists():
            return p
    sys.exit("fleet: fleet-kuma-seed not found")


def next_box_id(inv: dict) -> str:
    """Next free id: one above every id ever used, in the inventory and in the fleet site's registry
    (offboarded boxes keep their record, so a number is never handed out twice)."""
    nums = [int(b["id"][4:]) for b in inv["boxes"] if ID_RE.match(b["id"])]
    conf = load_push_conf()
    if conf:
        import requests
        try:
            r = requests.get(f"{conf['FLEET_SITE_URL'].rstrip('/')}/api/resource/Managed Box", timeout=30,
                             params={"fields": '["name"]', "limit_page_length": 1000},
                             headers={"Authorization": f"token {conf['FLEET_API_KEY']}:{conf['FLEET_API_SECRET']}",
                                      "Host": conf["FLEET_SITE_NAME"], "X-Frappe-Site-Name": conf["FLEET_SITE_NAME"]})
            r.raise_for_status()
            nums += [int(d["name"][4:]) for d in r.json().get("data", []) if ID_RE.match(d["name"])]
        except Exception as e:
            print(f"warning: fleet site unreachable ({e}); numbering from the inventory only")
    return f"box-{(max(nums) + 1) if nums else 1:03d}"


def cmd_onboard(a, inv):
    if not ALIAS_RE.match(a.alias):
        sys.exit("fleet: alias must be a short lowercase slug (letters, digits, dashes), e.g. malianova")
    if a.id and not ID_RE.match(a.id):
        sys.exit("fleet: ids look like box-007")
    for b in inv["boxes"]:
        if b["host"] == a.host:
            sys.exit(f"fleet: host {a.host} is already {label(b)}")
        if b["alias"] == a.alias:
            sys.exit(f"fleet: alias {a.alias} is already {label(b)}")
        if a.id and b["id"] == a.id:
            sys.exit(f"fleet: id {a.id} is already {label(b)}")
    new = a.id or next_box_id(inv)
    rank = a.rank if a.rank is not None else max([b["canary_rank"] for b in inv["boxes"]] + [0]) + 1
    box = {"id": new, "alias": a.alias, "host": a.host, "business": a.business, "role": a.role, "owner": a.owner,
           "profile": a.profile, "plan": a.plan or inv["defaults"].get("plan", "standard"), "status": "active",
           "canary_rank": rank, "contacts": {"billing": a.billing or "", "technical": a.technical or ""}}
    if a.connectivity:
        box["connectivity"] = a.connectivity
    if a.services:
        box["services"] = [x.strip() for x in a.services.split(",") if x.strip()]
    if a.timezone:
        box["timezone"] = a.timezone
    if a.window:
        box["maintenance_window"] = a.window
    inv["boxes"].append(box)
    save_inventory(inv)
    inv = load_inventory()
    box = select_boxes(inv, [new], False)[0]
    log_action(f"onboard {new} alias={a.alias} host={a.host} business={a.business!r} role={a.role} owner={a.owner}")
    print(f"registered {label(box)}: {a.business} at {a.host} (role {a.role}, owner {a.owner}, canary rank {rank})")
    push(inv, quiet=True)
    r = subprocess.run([str(kuma_seed_path()), "--boxes", new, "--no-notification"], capture_output=True, text=True)
    print("monitors: " + ("; ".join(l for l in r.stdout.splitlines() if l.startswith(("monitor", "KUMA"))) or r.stderr.strip()[-300:]))
    rc, _ = run_on(box, "test -r /etc/iiab/local_vars.yml", timeout=30)
    if rc == 0:
        import types
        cmd_vars(types.SimpleNamespace(action="pull", ids=[new], all=False), inv)
    else:
        print(f"not reachable yet over ssh ({box['ssh_user']}@{box['reach']['ssh']}): install this machine's key there, then `fleet vars pull {new}`")
    print(f"\nlocal_vars.yml on the box (before or after its install):\n  iiab_hostname: {new}\n  erpnext_business_name: \"{a.business}\"\n"
          f"next: fleet check {new}; fleet hostname {new} (inside its window); add {a.host} to BOXES in /etc/iiab/fleet-backup.conf"
          f" on the box that runs fleet-backup-mail" + (f"; fleet deploy-agent {new} (push mode)" if box["mode"] == "push" else ""))
    print(f"Check: fleet check {new} once the box is installed; its monitors are in Uptime Kuma ({read_conf(PUSH_CONF).get('KUMA_URL') or 'KUMA_URL unset'})")
    return 0


def cmd_rename(a, inv):
    box = select_boxes(inv, [a.id], False)[0]
    old, new = box["id"], a.new_id or box["id"]
    alias = a.alias or (box["alias"] if box["alias"] != old else new)
    if not ID_RE.match(new):
        sys.exit(f"fleet: ids look like box-007 (got {new!r})")
    if not ALIAS_RE.match(alias):
        sys.exit("fleet: alias must be a short lowercase slug (letters, digits, dashes)")
    for b in inv["boxes"]:
        if b is box:
            continue
        if b["id"] == new:
            sys.exit(f"fleet: id {new} is already {label(b)}")
        if b["alias"] == alias:
            sys.exit(f"fleet: alias {alias} is already {label(b)}")
    if (old, box["alias"]) == (new, alias):
        print("nothing to change")
        return 0
    old_alias = box["alias"]
    # 1. inventory (and the top-level pointers to a box)
    box["id"], box["alias"] = new, alias
    for k in ("hub_watchdog_box", "backup_mail_box"):
        if inv.get(k) == old:
            inv[k] = new
    save_inventory(inv)
    # 2. local state keyed by id: check history (with the id inside each record), vars copy, temp confs
    if old != new:
        src, dst = STATE / "checks" / old, STATE / "checks" / new
        if src.exists():
            src.rename(dst)
            for p in dst.glob("*.json"):
                try:
                    d = json.loads(p.read_text())
                    d["id"] = new
                    p.write_text(json.dumps(d, indent=1))
                except Exception:
                    pass
        v = Path("/etc/iiab/fleet-vars") / f"{old}.local_vars.yml"
        if v.exists():
            v.rename(v.with_name(f"{new}.local_vars.yml"))
        for p in (STATE / f"agent-{old}.conf", STATE / f"watchdog-{old}.conf"):
            p.unlink(missing_ok=True)
    # 3. the registry (links from checks and subscriptions follow the rename)
    ok, msg = site_call("fleet_ops.api.rename_box", {"old": old, "new": new, "alias": alias})
    print(f"fleet site: {msg if ok else 'FAILED: ' + str(msg)}")
    push(inv, quiet=True)
    # 4. monitors: names carry id + alias; the per-box push token derives from the id
    r = subprocess.run([str(kuma_seed_path()), "--rename", old, new, "--alias", alias], capture_output=True, text=True)
    print("monitors: " + ("; ".join(l for l in r.stdout.splitlines() if l.startswith(("monitor", "KUMA"))) or r.stderr.strip()[-300:]))
    log_action(f"rename {old} ({old_alias}) -> {new} ({alias}) site={'ok' if ok else 'failed'} kuma_rc={r.returncode}")
    print(f"{old} ({old_alias}) is now {new} ({alias})")
    if box["mode"] == "push":
        print(f"push-mode box: run `fleet deploy-agent {new}` (its agent token and push URL changed)")
    if old != new:
        print(f"inside its window: `fleet hostname {new}` renames the machine itself")
    return 0 if ok and r.returncode == 0 else 1


HOSTNAME_SCRIPT = r"""set -e
new="$1"; old=$(hostnamectl --static 2>/dev/null || hostname)
python3 - "$new" <<'PY'
import re, sys
new = sys.argv[1]
lines, out, seen = open("/etc/hosts").read().splitlines(), [], set()
for l in lines:                      # IIAB appends its line on every run: collapse duplicates
    k = " ".join(l.split())
    if k and not l.startswith("#") and k in seen:
        continue
    seen.add(k); out.append(l)
hosts = "\n".join(out).rstrip("\n") + "\n"
want = f"127.0.0.1 box.lan localhost.localdomain localhost box {new} {new}.lan"
m = re.search(r"^127\.0\.0\.1\s+.*\bbox\.lan\b.*$", hosts, re.M)
hosts = hosts.replace(m.group(0), want, 1) if m else hosts + want + "\n"
open("/etc/hosts", "w").write(hosts)
PY
hostnamectl set-hostname "$new"
grep -q '^iiab_hostname:' /etc/iiab/local_vars.yml && sed -i "s/^iiab_hostname:.*/iiab_hostname: $new/" /etc/iiab/local_vars.yml || true
if command -v tailscale >/dev/null; then tailscale set --hostname "$new" 2>&1 | head -1 || true; fi
echo "HOSTNAME-OK $(hostname) (was $old)"
"""


def cmd_hostname(a, inv):
    """Make the machine's own name match its id: /etc/hosts, hostnamectl, iiab_hostname in
    local_vars (so IIAB never writes the old name back), and the tailnet hostname."""
    box = select_boxes(inv, [a.id], False)[0]
    if not ID_RE.match(box["id"]):
        sys.exit(f"fleet: {box['id']} is not a box-NNN id yet (fleet rename first)")
    if not (a.now or box.get("local") or in_window(box)):
        sys.exit(f"fleet: {label(box)} is outside its maintenance window {box.get('maintenance_window')} ({box.get('timezone')}); use --now")
    tmp = STATE / f"hostname-{box['id']}.sh"
    tmp.write_text(HOSTNAME_SCRIPT)
    scp_to(box, tmp, "/root/fleet-hostname.sh", "0700")
    rc, out = run_on(box, f"bash /root/fleet-hostname.sh {shlex.quote(box['id'])}; r=$?; rm -f /root/fleet-hostname.sh; exit $r", timeout=120)
    tmp.unlink(missing_ok=True)
    print(out[-600:])
    log_action(f"hostname {box['id']} rc={rc}")
    if rc == 0:
        print(f"Check: ssh {box['ssh_user']}@{box['reach']['ssh']} hostname   # {box['id']}; fleet tailnet shows the node's name once its admins rename it")
    return 0 if rc == 0 else 1


def cmd_authorize_key(a, inv):
    """Let another machine (typically the next hub) in as root on the selected boxes: append
    its public key to /root/.ssh/authorized_keys where it is missing. --check only reports."""
    pub = Path(a.file).read_text().strip().splitlines()
    pub = [l for l in pub if l and not l.startswith("#")]
    if len(pub) != 1 or not re.match(r"^(ssh-(rsa|ed25519)|ecdsa-sha2-\S+) \S+", pub[0]):
        sys.exit("fleet: expected one OpenSSH public key line in the file")
    key = pub[0]
    keytype, blob = key.split()[:2]
    rc_all = 0
    for b in select_boxes(inv, a.ids, a.all):
        probe = f"grep -qsF {shlex.quote(blob)} /root/.ssh/authorized_keys && echo PRESENT || echo ABSENT"
        rc, out = run_on(b, probe, timeout=30)
        if rc != 0 and "ABSENT" not in out and "PRESENT" not in out:
            print(f"{label(b)}: unreachable ({out[-80:]})")
            rc_all = 1
            continue
        if "PRESENT" in out:
            print(f"{label(b)}: already present")
            continue
        if a.check:
            print(f"{label(b)}: absent")
            continue
        add = (f"install -d -m 700 /root/.ssh && printf '%s\\n' {shlex.quote(key)} >> /root/.ssh/authorized_keys"
               f" && chmod 600 /root/.ssh/authorized_keys && echo ADDED")
        rc, out = run_on(b, add, timeout=30)
        print(f"{label(b)}: {'added' if 'ADDED' in out else 'FAILED ' + out[-80:]}")
        rc_all = rc_all or (0 if "ADDED" in out else 1)
    log_action(f"authorize-key {keytype} {blob[-12:]} check={a.check} boxes={','.join(b['id'] for b in select_boxes(inv, a.ids, a.all))}")
    return rc_all


# ----------------------------------------------------------------------------- main


def main(argv=None) -> int:
    ap = argparse.ArgumentParser(prog="fleet", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("list"); sub.add_parser("status"); sub.add_parser("tailnet")
    p = sub.add_parser("check"); p.add_argument("ids", nargs="*"); p.add_argument("--all", action="store_true"); p.add_argument("--no-push", action="store_true")
    p = sub.add_parser("digest"); p.add_argument("--send", action="store_true")
    p = sub.add_parser("manifest"); ps = p.add_subparsers(dest="action", required=True)
    c = ps.add_parser("capture"); c.add_argument("--id", required=True); c.add_argument("--from", dest="from_box"); c.add_argument("--notes"); c.add_argument("--force", action="store_true")
    ps.add_parser("list"); c = ps.add_parser("show"); c.add_argument("id"); c = ps.add_parser("set-current"); c.add_argument("id")
    p = sub.add_parser("upgrade"); p.add_argument("ids", nargs="*"); p.add_argument("--all", action="store_true"); p.add_argument("--release"); p.add_argument("--preflight", action="store_true"); p.add_argument("--now", action="store_true"); p.add_argument("--allow-discard")
    p = sub.add_parser("suspend"); p.add_argument("id"); p.add_argument("--reason", default="")
    p = sub.add_parser("resume"); p.add_argument("id")
    p = sub.add_parser("offboard"); p.add_argument("id")
    sub.add_parser("push")
