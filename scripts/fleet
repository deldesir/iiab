    p = sub.add_parser("reboot"); p.add_argument("id", nargs="?"); p.add_argument("--all", action="store_true"); p.add_argument("--now", action="store_true")
    p = sub.add_parser("backup-pull"); p.add_argument("--dest")
    p = sub.add_parser("rollback"); p.add_argument("id"); p.add_argument("--release"); p.add_argument("--no-restore", action="store_true"); p.add_argument("--dry-run", action="store_true"); p.add_argument("--now", action="store_true")
    p = sub.add_parser("dunning"); p.add_argument("--apply", action="store_true")
    p = sub.add_parser("vars"); p.add_argument("action", choices=["pull", "diff", "show"]); p.add_argument("ids", nargs="*"); p.add_argument("--all", action="store_true")
    p = sub.add_parser("onboard"); p.add_argument("--host", required=True); p.add_argument("--business", required=True); p.add_argument("--alias", required=True)
    p.add_argument("--role", default="customer", choices=["customer", "till", "hub", "observer"]); p.add_argument("--owner", default="customer", choices=["customer", "self"])
    p.add_argument("--profile", default="retail"); p.add_argument("--plan"); p.add_argument("--connectivity", choices=["public", "tailnet", "offline"])
    p.add_argument("--services"); p.add_argument("--billing"); p.add_argument("--technical"); p.add_argument("--timezone"); p.add_argument("--window")
    p.add_argument("--rank", type=int); p.add_argument("--id")
    p = sub.add_parser("rename"); p.add_argument("id"); p.add_argument("new_id", nargs="?"); p.add_argument("--alias")
    p = sub.add_parser("hostname"); p.add_argument("id"); p.add_argument("--now", action="store_true")
    p = sub.add_parser("authorize-key"); p.add_argument("file"); p.add_argument("ids", nargs="*"); p.add_argument("--all", action="store_true"); p.add_argument("--check", action="store_true")
    a = ap.parse_args(argv)
    inv = load_inventory()
    return {"list": cmd_list, "status": cmd_status, "tailnet": cmd_tailnet, "check": cmd_check, "digest": cmd_digest, "manifest": cmd_manifest,
            "upgrade": cmd_upgrade, "suspend": cmd_suspend, "resume": cmd_resume, "offboard": cmd_offboard, "push": cmd_push,
            "agent-token": cmd_agent_token, "deploy-agent": cmd_deploy_agent, "deploy-watchdog": cmd_deploy_watchdog,
            "runrole": cmd_runrole, "vars": cmd_vars, "reboot": cmd_reboot, "backup-pull": cmd_backup_pull,
            "onboard": cmd_onboard, "rename": cmd_rename, "hostname": cmd_hostname, "authorize-key": cmd_authorize_key,
            "rollback": cmd_rollback, "dunning": cmd_dunning}[a.cmd](a, inv)


