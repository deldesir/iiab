#!/usr/bin/env python3
"""fleet: the entry point. The command lives in the fleet_tool package beside this file: in the
repository that is scripts/fleet_tool, and a run from a checkout uses that checkout's package
(so a branch can be tried from a worktree). The installed copy of this file has no package
beside it and finds the installed package (/usr/local/lib/fleet_tool), then the repository's.
`fleet --help` for the commands."""
import sys
from pathlib import Path

_here = Path(__file__).resolve().parent
for cand in (_here, Path("/usr/local/lib"), Path("/opt/iiab/iiab/scripts")):
    if (cand / "fleet_tool" / "cli.py").exists():
        sys.path.insert(0, str(cand))
        break
else:
    sys.exit("fleet: the fleet_tool package is missing (install it beside this file or keep the repository at /opt/iiab/iiab)")

from fleet_tool.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
