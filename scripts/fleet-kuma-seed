#!/var/lib/fleet/venv/bin/python
"""fleet-kuma-seed — put Uptime Kuma in the state the fleet needs, idempotently.

Reads the inventory (/etc/iiab/fleet.yml) and /etc/iiab/fleet.conf (KUMA_URL,
KUMA_ADMIN_USER, KUMA_ADMIN_PASSWORD, KUMA_PUSH_TOKEN; the last two are generated and
written back on first run), the operator address (RECIPIENT in /etc/iiab/fleet-backup.conf)
and the email bridge's send token (EMAIL_SEND_AUTH in the bridge's .env; used in-process,
never printed). Then:

  1. first-run database setup (SQLite) and the admin account, if still needed
  2. server settings: operator timezone, primary base URL, no update checks
  3. one default notification: webhook -> email bridge /send-json -> operator mailbox
  4. per box, from the services it carries (all of them when it declares none):
              "<id> <alias> ERP api"     erp:           keyword 'pong' on /erp/api/method/ping, TLS expiry on
              "<id> <alias> storefront"  storefront:    HTTP 200 on /
              "<id> <alias> fleet site"  control-plane: keyword 'pong' on FLEET_PUBLIC_URL/api/method/ping
              (just "<id> …" when alias = id)
  5. one push monitor "fleet-check" that `fleet check` feeds (down = a box failed)
  6. a status page /status/fleet listing the ERP api monitors

Re-running only adds what is missing; --prune also deletes a box's monitors of kinds it no
longer warrants (a box that lost a service, a hub that carries no shop). Exit 0 on success.
  --rename OLD NEW [--alias A]: rename one box's monitors (and refresh its push token) and exit;
  used by `fleet rename`.
"""
import json
import os
import secrets
import sys
import time
from pathlib import Path

import requests
import socketio
import yaml

INVENTORY = Path("/etc/iiab/fleet.yml")
CONF = Path("/etc/iiab/fleet.conf")
BACKUP_CONF = Path("/etc/iiab/fleet-backup.conf")
BRIDGE_ENV = Path("/opt/iiab/email-bridge/.env")
BRIDGE_URL = "http://127.0.0.1:8096/send-json"


def read_kv(p: Path) -> dict:
    out = {}
    if p.exists():
        for line in p.read_text().splitlines():
            line = line.strip()
            if line and not line.startswith("#") and "=" in line:
                k, _, v = line.partition("=")
                out[k.strip()] = v.strip().strip('"')
    return out


def set_kv(p: Path, key: str, value: str) -> None:
    lines = p.read_text().splitlines() if p.exists() else []
    for i, line in enumerate(lines):
        if line.startswith(f"{key}="):
            lines[i] = f"{key}={value}"
            break
    else:
        lines.append(f"{key}={value}")
    p.write_text("\n".join(lines) + "\n")
    os.chmod(p, 0o600)


def parse_args():
    import argparse
    ap = argparse.ArgumentParser(description="Seed Uptime Kuma for the fleet (idempotent).")
    ap.add_argument("--url", help="Uptime Kuma base URL (default KUMA_URL from the conf, else the hub tailnet address)")
    ap.add_argument("--conf", default=str(CONF), help="where KUMA_* credentials live (default /etc/iiab/fleet.conf)")
    ap.add_argument("--boxes", help="comma-separated box ids to monitor (default: all)")
    ap.add_argument("--no-notification", action="store_true", help="do not create the email-bridge webhook notification")
    ap.add_argument("--no-status-page", action="store_true")
    ap.add_argument("--no-push-monitors", action="store_true", help="skip the per-box and fleet-wide push monitors")
    ap.add_argument("--prune", action="store_true", help="delete a box's monitors of kinds its services no longer warrant")
    ap.add_argument("--rename", nargs=2, metavar=("OLD", "NEW"), help="rename one box's monitors (old id -> new id) and exit")
    ap.add_argument("--alias", help="alias to show in the renamed monitors' names")
    return ap.parse_args()


KINDS = ("ERP api", "storefront", "fleet site", "check")


def monitor_name(box_id: str, alias: str | None, kind: str) -> str:
    return f"{box_id} {alias} {kind}" if alias and alias != box_id else f"{box_id} {kind}"


def monitor_kind(name: str, box_id: str) -> str | None:
    """Which kind a monitor named for box_id is ('<id> [alias] <kind>'), else None."""
    for k in KINDS:
        if name == f"{box_id} {k}" or (name.startswith(f"{box_id} ") and name.endswith(f" {k}") and " " not in name[len(box_id) + 1:-len(k) - 1]):
            return k
    return None


def main() -> int:
    global CONF
    args = parse_args()
    CONF = Path(args.conf)
    conf = read_kv(CONF)
    url = args.url or conf.get("KUMA_URL") or "http://100.64.0.18:3001"
    user = conf.get("KUMA_ADMIN_USER") or "fleet"
    pw = conf.get("KUMA_ADMIN_PASSWORD")
    if not pw:
        pw = secrets.token_urlsafe(18)
        set_kv(CONF, "KUMA_URL", url)
        set_kv(CONF, "KUMA_ADMIN_USER", user)
        set_kv(CONF, "KUMA_ADMIN_PASSWORD", pw)
        print("generated the Uptime Kuma admin password into", CONF)
    push_token = conf.get("KUMA_PUSH_TOKEN")
    if not push_token:
        push_token = secrets.token_hex(16)
        set_kv(CONF, "KUMA_PUSH_TOKEN", push_token)
    operator = read_kv(BACKUP_CONF).get("RECIPIENT") or ""
    bridge_token = read_kv(BRIDGE_ENV).get("EMAIL_SEND_AUTH") or ""
    if not args.no_notification and (not operator or not bridge_token):
        sys.exit("fleet-kuma-seed: operator address or bridge token missing (use --no-notification where the bridge is not local)")
    inv = yaml.safe_load(INVENTORY.read_text())
    tz = (inv.get("defaults") or {}).get("timezone") or "UTC"

    # 1. first-run database setup
    for _ in range(30):
        try:
            entry = requests.get(f"{url}/api/entry-page", timeout=5).json()
            break
        except Exception:
            time.sleep(2)
    else:
        sys.exit("fleet-kuma-seed: Uptime Kuma is not answering")
    if entry.get("type") == "setup-database":
        r = requests.post(f"{url}/setup-database", json={"dbConfig": {"type": "sqlite"}}, timeout=60)
        print("database setup:", r.status_code, r.text[:80])
        for _ in range(60):
            time.sleep(2)
            try:
                if requests.get(f"{url}/api/entry-page", timeout=5).json().get("type") != "setup-database":
                    break
            except Exception:
                pass
        else:
            sys.exit("fleet-kuma-seed: server did not come back after database setup")

    sio = socketio.Client(logger=False, engineio_logger=False)
    state = {"monitors": {}, "notifications": []}

    @sio.on("monitorList")
    def _ml(data):
        state["monitors"] = data or {}

    @sio.on("notificationList")
    def _nl(data):
        state["notifications"] = data or []

    # After the database step the server migrates and re-listens; connect until it answers.
    need = None
    for attempt in range(12):
        try:
            if not sio.connected:
                sio.connect(url, transports=["websocket"], wait_timeout=20)
            need = sio.call("needSetup", timeout=15)
            break
        except Exception as e:
            print(f"waiting for the socket server ({e.__class__.__name__}), attempt {attempt + 1}")
            try:
                sio.disconnect()
            except Exception:
                pass
            time.sleep(5)
    if need is None:
        sys.exit("fleet-kuma-seed: socket server never answered")
    if need:
        res = sio.call("setup", (user, pw), timeout=30)
        print("admin setup:", res.get("msg", res))
    res = sio.call("login", {"username": user, "password": pw, "token": ""}, timeout=30)
    if not res.get("ok"):
        sys.exit(f"fleet-kuma-seed: login failed: {res.get('msg')}")
    time.sleep(2)  # the server pushes monitorList / notificationList after login

    if args.rename:
        for _ in range(50):                     # the monitor list arrives right after login
            if state["monitors"]:
                break
            time.sleep(0.2)
        old, new = args.rename
        new_tok = __import__("hmac").new(push_token.encode(), f"box:{new}".encode(), __import__("hashlib").sha256).hexdigest()[:32]
        n = 0
        for m in list(state["monitors"].values()):
            kind = monitor_kind(m.get("name", ""), old)
            if not kind:
                continue
            m = dict(m)
            m["name"] = monitor_name(new, args.alias, kind)
            if kind == "check":
                m["pushToken"] = new_tok
                m["description"] = f"Fed by the fleet check for {new}: down = CRIT or STALE, or no check for 26 h"
            r = sio.call("editMonitor", m, timeout=30)
            print(("monitor renamed: " if r.get("ok") else "monitor rename FAILED: ") + m["name"] + ("" if r.get("ok") else " " + str(r.get("msg"))))
            n += 1 if r.get("ok") else 0
        sio.disconnect()
        print(f"KUMA-RENAME-OK {old} -> {new} ({n} monitors)" if n else f"KUMA-RENAME-NONE {old}")
        return 0 if n else 1

    # 2. settings
    settings = sio.call("getSettings", timeout=20).get("data", {})
    settings.update({"serverTimezone": tz, "primaryBaseURL": url, "checkUpdate": False,
                     "checkBeta": False, "searchEngineIndex": False, "entryPage": "dashboard",
                     "tlsExpiryNotifyDays": [7, 14, 21], "keepDataPeriodDays": 180})
    r = sio.call("setSettings", (settings, pw), timeout=20)
    print("settings:", r.get("msg", r))

    # 3. default notification -> email bridge -> operator
    want_name = "Operator email (bridge)"
    existing = [n for n in state["notifications"] if n.get("name") == want_name]
    notif_id = None
    if existing:
        notif_id = existing[0]["id"]
        print("notification exists:", notif_id)
    elif args.no_notification:
        print("notification: skipped (configure one in the UI: SMTP, Telegram...)")
    else:
        body = (
            '{% capture subj %}[fleet] {{ name }} {{ status }}{% endcapture %}'
            '{% capture text %}{{ msg }}\n\n{{ hostnameOrURL }}'
            '{% if heartbeatJSON %}\n{{ heartbeatJSON.time }} — {{ heartbeatJSON.msg }}{% endif %}{% endcapture %}'
            '{"to": ' + json.dumps(operator) + ', "subject": {{ subj | json }}, "text": {{ text | json }}, '
            '"id": "kuma-{{ heartbeatJSON.monitorID }}-{{ heartbeatJSON.time }}"}'
        )
        notification = {"name": want_name, "type": "webhook", "isDefault": True, "applyExisting": True,
                        "webhookURL": BRIDGE_URL, "httpMethod": "post", "webhookContentType": "custom",
                        "webhookCustomBody": body,
                        "webhookAdditionalHeaders": json.dumps({"Authorization": bridge_token,
                                                                "Content-Type": "application/json"})}
        r = sio.call("addNotification", (notification, None), timeout=20)
        if not r.get("ok"):
            sys.exit(f"fleet-kuma-seed: addNotification failed: {r.get('msg')}")
        notif_id = r["id"]
        print("notification created:", notif_id)
        t = sio.call("testNotification", notification, timeout=60)
        print("notification test:", t.get("msg", t))

    # 4. monitors
    base = {
        "type": "http", "name": "", "parent": None, "url": "", "method": "GET", "protocol": None,
        "location": "world", "ipFamily": None, "interval": 60, "retryInterval": 60, "resendInterval": 0,
        "maxretries": 2, "retryOnlyOnStatusCodeFailure": False, "notificationIDList": ({str(notif_id): True} if notif_id else {}),
        "ignoreTls": False, "upsideDown": False, "expiryNotification": True, "domainExpiryNotification": False,
        "maxredirects": 10, "accepted_statuscodes": ["200-299"], "saveResponse": False, "saveErrorResponse": True,
        "responseMaxLength": 1024, "dns_resolve_type": "A", "dns_resolve_server": "", "docker_container": "",
        "docker_host": None, "proxyId": None, "basic_auth_user": "", "basic_auth_pass": "", "bearer_token": "",
        "mqttUsername": "", "mqttPassword": "", "mqttTopic": "", "mqttWebsocketPath": "", "mqttSuccessMessage": "",
        "mqttCheckType": "keyword", "authMethod": None, "oauth_auth_method": "client_secret_basic",
        "httpBodyEncoding": "json", "kafkaProducerBrokers": [], "kafkaProducerSaslOptions": {"mechanism": "None"},
        "cacheBust": False, "kafkaProducerSsl": False, "kafkaProducerAllowAutoTopicCreation": False,
        "gamedigGivenPortOnly": True, "gamedigToken": "", "remote_browser": None, "screenshot_delay": 0,
        "rabbitmqNodes": [], "rabbitmqUsername": "", "rabbitmqPassword": "", "conditions": [],
        "system_service_name": "", "sshAuthMethod": "password", "ntpStratumThreshold": 5,
        "ntpTimeOffsetThreshold": 1000, "ntpRootDispersionThreshold": 500, "timeout": 30,
    }
    have = {m.get("name"): m for m in state["monitors"].values()}
    api_ids, site_ids = [], []
    fleet_public = (conf.get("FLEET_PUBLIC_URL") or "").rstrip("/")

    def prune(box_id: str, keep: set[str]) -> None:
        """Delete this box's monitors whose kind is not wanted any more (only with --prune)."""
        if not args.prune:
            return
        for m in list(state["monitors"].values()):
            kind = monitor_kind(m.get("name", ""), box_id)
            if kind and kind not in keep:
                r = sio.call("deleteMonitor", m["id"], timeout=30)
                print(("monitor deleted: " if r.get("ok") else "monitor delete FAILED: ") + m["name"])
                have.pop(m.get("name"), None)

    def ensure(spec: dict, legacy: str | None = None) -> int | None:
        if spec["name"] in have:
            print("monitor exists:", spec["name"])
            return have[spec["name"]]["id"]
        if legacy and legacy in have:                      # same monitor under its pre-alias name
            m = dict(have[legacy]); m["name"] = spec["name"]
            r = sio.call("editMonitor", m, timeout=30)
            print(("monitor renamed: " if r.get("ok") else "monitor rename FAILED: ") + spec["name"])
            return m["id"]
        m = dict(base); m.update(spec)
        r = sio.call("add", m, timeout=30)
        if not r.get("ok"):
            print("monitor FAILED:", spec["name"], r.get("msg"))
            return None
        print("monitor created:", spec["name"])
        return r.get("monitorID")

    import hmac, hashlib
    wanted = set(args.boxes.split(",")) if args.boxes else None
    for b in sorted(inv["boxes"], key=lambda b: (b.get("canary_rank", 99), b["id"])):
        if wanted and b["id"] not in wanted:
            continue
        host = b["host"]
        conn = b.get("connectivity") or inv.get("defaults", {}).get("connectivity") or "public"
        reach = b.get("reach") or {}
        url_base = reach.get("http") or (f"https://{host}" if conn == "public" else f"http://{reach.get('ssh', host)}")
        alias = b.get("alias") or b["id"]
        services = set(b.get("services") or ["erp", "storefront"])   # no declaration = a classic shop box
        keep = {"check"}
        if conn != "offline":   # offline boxes are never polled; their push monitor below carries them
            if "erp" in services:
                keep.add("ERP api")
                mid = ensure({"type": "keyword", "name": monitor_name(b["id"], alias, "ERP api"), "url": f"{url_base}/erp/api/method/ping",
                              "keyword": "pong", "interval": 60, "expiryNotification": conn == "public", "ignoreTls": conn != "public"},
                             legacy=f"{b['id']} ERP api")
                if mid:
                    api_ids.append(mid)
            if "storefront" in services:
                keep.add("storefront")
                ensure({"type": "http", "name": monitor_name(b["id"], alias, "storefront"), "url": f"{url_base}/", "interval": 120,
                        "expiryNotification": conn == "public", "ignoreTls": conn != "public"}, legacy=f"{b['id']} storefront")
            if "control-plane" in services and fleet_public:   # the hub: what matters is the fleet site, not a shop
                keep.add("fleet site")
                mid = ensure({"type": "keyword", "name": monitor_name(b["id"], alias, "fleet site"), "url": f"{fleet_public}/api/method/ping",
                              "keyword": "pong", "interval": 60, "expiryNotification": False, "ignoreTls": True})
                if mid:
                    site_ids.append(mid)
        prune(b["id"], keep)
        if not args.no_push_monitors:
            # per-box push monitor: `fleet check` (or fleet-agent) feeds it; down = CRIT or STALE
            tok = hmac.new(push_token.encode(), f"box:{b['id']}".encode(), hashlib.sha256).hexdigest()[:32]
            ensure({"type": "push", "name": monitor_name(b["id"], alias, "check"), "url": "", "pushToken": tok, "interval": 93600,
                    "retryInterval": 3600, "maxretries": 0, "expiryNotification": False,
                    "description": f"Fed by the fleet check for {b['id']}: down = CRIT or STALE, or no check for 26 h"}, legacy=f"{b['id']} check")

    # 5. fleet-wide push monitor: did the nightly check run at all
    if not args.no_push_monitors:
        ensure({"type": "push", "name": "fleet-check", "url": "", "pushToken": push_token, "interval": 93600,
                "retryInterval": 3600, "maxretries": 0, "expiryNotification": False,
                "description": "Fed by the nightly `fleet check --all` run; down means the check never ran"})

    # 6. status page
    if args.no_status_page:
        sio.disconnect()
        print(f"KUMA-SEED-OK {url} (no status page)")
        return 0
    slug = "fleet"
    r = sio.call("addStatusPage", ("Fleet status", slug), timeout=20)
    print("status page:", r.get("msg", r))          # "already exists" on a re-run is fine
    config = {"slug": slug, "title": "Fleet status", "description": "ERP availability per managed box (tailnet-only page)",
              "theme": "auto", "published": True, "showTags": False, "domainNameList": [], "customCSS": "",
              "footerText": "", "showPoweredBy": False, "showCertificateExpiry": True, "autoRefreshInterval": 300}
    groups = [{"name": "ERP boxes", "weight": 1, "monitorList": [{"id": i} for i in api_ids]}]
    if site_ids:
        groups.append({"name": "Control plane", "weight": 2, "monitorList": [{"id": i} for i in site_ids]})
    config["icon"] = "/icon.svg"
    config["analyticsType"] = None
    r = sio.call("saveStatusPage", (slug, config, "/icon.svg", groups), timeout=30)
    print("status page saved:", r.get("msg", r))
    sio.disconnect()
    print(f"KUMA-SEED-OK {url}  status page: {url}/status/{slug}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
