# AI Gateway environment — generated by Ansible from local_vars.yml
# DO NOT EDIT MANUALLY: changes will be overwritten on next Ansible run
# To change settings, edit /etc/iiab/local_vars.yml and re-run:
#   sudo iiab-role ai-gateway
#
# Machine-local secrets (keys set on this box only) belong in .env.local
# alongside this file — never written by Ansible, loaded last, always wins.

# ── LLM (native Gemini provider or custom endpoint) ──────────────────
LLM_MODEL={{ ai_gateway_llm_model }}
LLM_MODEL_SUMMARIZE={{ ai_gateway_llm_model_summarize }}
{% if ai_gateway_hermes_provider %}
# Native provider path (LiteLLM retired): the engine uses this provider's
# built-in endpoint (e.g. "gemini" → Google AI Studio). No proxy on :4000.
HERMES_PROVIDER={{ ai_gateway_hermes_provider }}
{% endif %}
{% if ai_gateway_gemini_api_key %}
GEMINI_API_KEY={{ ai_gateway_gemini_api_key }}
{% endif %}
{% if not ai_gateway_hermes_provider %}
# OpenAI-compatible fallback (used only when no native provider is set).
OPENAI_API_BASE={{ ai_gateway_openai_api_base }}
OPENAI_API_KEY={{ ai_gateway_openai_api_key }}
LITELLM_BASE_URL={{ ai_gateway_openai_api_base }}/v1
{% else %}
# LiteLLM proxy decommissioned — the native provider path is active; the
# openai-compat fallback only fires when HERMES_PROVIDER is unset.
{% endif %}
LLM_TEMPERATURE={{ ai_gateway_llm_temperature | default('0.3') }}

# ── Embeddings ───────────────────────────────────────────────────────
EMBEDDING_PROVIDER={{ ai_gateway_embedding_provider }}
EMBEDDING_MODEL={{ ai_gateway_embedding_model }}
# MemPalace embedding model. v3.3.6+ defaults to multilingual 'embeddinggemma',
# which is too memory-heavy for 4 GB edge targets (OOM risk under MemoryMax).
# Pin 'minilm' to preserve the current footprint; switch to 'embeddinggemma'
# only after testing memory on the target device (better Creole/French recall).
MEMPALACE_EMBEDDING_MODEL={{ ai_gateway_mempalace_embedding_model | default('minilm') }}

# ── RapidPro integration ─────────────────────────────────────────────
RAPIDPRO_HOST={{ ai_gateway_rapidpro_host }}
RAPIDPRO_API_TOKEN={{ ai_gateway_rapidpro_token }}

# ── SiYuan integration (talkmaster/jwlinker notebook sync) ───────────
SIYUAN_URL={{ ai_gateway_siyuan_url }}
{% if ai_gateway_siyuan_token %}
SIYUAN_API_TOKEN={{ ai_gateway_siyuan_token }}
{% endif %}
# ── Persistence ──────────────────────────────────────────────────────
SQLITE_DB_PATH={{ ai_gateway_dir }}/checkpoints.sqlite
{% if ai_gateway_postgres_uri %}
POSTGRES_URI={{ ai_gateway_postgres_uri }}
{% endif %}

# ── jwlinker ─────────────────────────────────────────────────────────
{% if ai_gateway_jwlinker_db_path %}
JWLINKER_DB_PATH={{ ai_gateway_jwlinker_db_path }}
{% endif %}

# ── Optional ─────────────────────────────────────────────────────────
{% if ai_gateway_admin_phone %}
ADMIN_PHONE="{{ ai_gateway_admin_phone }}"
{% endif %}
{% if ai_gateway_api_key %}
GATEWAY_API_KEY={{ ai_gateway_api_key }}
{% endif %}
{% if ai_gateway_authorized_users %}
AUTHORIZED_USERS="{{ ai_gateway_authorized_users }}"
{% endif %}
{% if ai_gateway_default_persona is defined and ai_gateway_default_persona %}
DEFAULT_PERSONA={{ ai_gateway_default_persona }}
{% endif %}

# ── WuzAPI (direct WhatsApp actions: reactions, read receipts, typing) ─
# The channel's user token is read from the WZ channel row in the shared
# RapidPro database, so a re-claimed channel needs no change here.
# ai_gateway_wuzapi_token is an explicit override for boxes without that DB.
WUZAPI_URL={{ wuzapi_url | default('http://localhost:' ~ (wuzapi_port | default('8095') | string)) }}
{% if ai_gateway_wuzapi_token is defined and ai_gateway_wuzapi_token %}
WUZAPI_TOKEN={{ ai_gateway_wuzapi_token }}
{% endif %}

# ── Chat turn budget (answer before mailroom's 60 s client timeout) ──
HERMES_TURN_BUDGET_SECS={{ ai_gateway_turn_budget_secs | default(45) }}

{% if ai_gateway_erpnext_url %}
# ── ERPNext read-only business view (operator persona) ──────────────
ERPNEXT_URL={{ ai_gateway_erpnext_url }}
{% if ai_gateway_erpnext_host %}
ERPNEXT_HOST={{ ai_gateway_erpnext_host }}
{% endif %}
ERPNEXT_API_KEY={{ ai_gateway_erpnext_api_key }}
ERPNEXT_API_SECRET={{ ai_gateway_erpnext_api_secret }}
{% endif %}

# ── V2: SiYuan Knowledge Wiki ────────────────────────────────────────
SIYUAN_API_URL={{ ai_gateway_siyuan_api_url | default('http://localhost:6806') }}
{% if ai_gateway_siyuan_notebook_id %}
SIYUAN_NOTEBOOK_ID={{ ai_gateway_siyuan_notebook_id }}
{% endif %}
{% if siyuan_access_auth_code is defined and siyuan_access_auth_code %}
SIYUAN_ACCESS_AUTH_CODE={{ siyuan_access_auth_code }}
{% endif %}

# ── V2: Hermes Agent + MemPalace ─────────────────────────────────────
# Also set in systemd service unit (Environment= directives take precedence).
# Kept here for visibility during manual debugging and #debug commands.
HERMES_HOME={{ hermes_agent_home | default(ai_gateway_dir ~ '/data/hermes') }}
MEMPALACE_PALACE_PATH={{ mempalace_palace_path | default(ai_gateway_dir ~ '/data/palace') }}
# Pin the knowledge graph to one file: without this the path follows $HOME and
# services/cron/shells can each silently open a different (empty) graph.
MEMPALACE_KG_PATH={{ mempalace_kg_path | default(ai_gateway_dir ~ '/.mempalace/knowledge_graph.sqlite3') }}
OMP_NUM_THREADS=1
TOKENIZERS_PARALLELISM=false

# ── Webhooks ─────────────────────────────────────────────────────────
GATEWAY_WEBHOOK_URL={{ ai_gateway_webhook_url | default('http://127.0.0.1:8086') }}
RAPIDPRO_WEBHOOK_HOST={{ ai_gateway_rapidpro_webhook_host | default('http://localhost') }}

# ── Organized (congregation schedule query API) ─────────────────────
{% if organized_webhook_secret is defined and organized_webhook_secret %}
ORGANIZED_URL={{ ai_gateway_organized_url | default('http://127.0.0.1:8088') }}
ORGANIZED_WEBHOOK_SECRET={{ organized_webhook_secret }}
{% endif %}

# ── Talk sync (Organized schedule → talkmaster revisions, nightly) ──
{% if talk_sync_speaker is defined and talk_sync_speaker %}
TALK_SYNC_SPEAKER={{ talk_sync_speaker }}
TALK_SYNC_LANGUAGE={{ talk_sync_language | default('ht') }}
TALK_SYNC_PUB={{ talk_sync_pub | default('s34') }}
{% endif %}

# ── Cockpit deliverables (capture → sitrep / month-end drafts) ───────
# Deployment labels for the drafted work deliverables. Absent/blank = the
# app's generic fallbacks (empty site line, "your supervisor / HQ", the
# default Life / 💼 Work notebooks). Set the box-local values in
# local_vars.yml; the capture data itself lives in data/captures.jsonl.
{% if ai_gateway_work_site is defined and ai_gateway_work_site %}
WORK_SITE="{{ ai_gateway_work_site }}"
{% endif %}
{% if ai_gateway_sitrep_recipient is defined and ai_gateway_sitrep_recipient %}
SITREP_RECIPIENT="{{ ai_gateway_sitrep_recipient }}"
{% endif %}
{% if ai_gateway_sitrep_lang is defined and ai_gateway_sitrep_lang %}
SITREP_LANG="{{ ai_gateway_sitrep_lang }}"
{% endif %}
{% if ai_gateway_cockpit_notebook is defined and ai_gateway_cockpit_notebook %}
COCKPIT_NOTEBOOK="{{ ai_gateway_cockpit_notebook }}"
{% endif %}
{% if ai_gateway_travay_notebook is defined and ai_gateway_travay_notebook %}
TRAVAY_NOTEBOOK="{{ ai_gateway_travay_notebook }}"
{% endif %}
{% if ai_gateway_ministry_goal_hours is defined and ai_gateway_ministry_goal_hours %}
MINISTRY_GOAL_HOURS="{{ ai_gateway_ministry_goal_hours }}"
{% endif %}
{% if ai_gateway_secretary_reports is defined and ai_gateway_secretary_reports %}
SECRETARY_REPORTS="1"
{% endif %}

# Contact directory (docs/contact-sync.md). Box-local values in local_vars.yml;
# anything absent keeps the app's defaults (English replies, no short names).
{% if ai_gateway_contact_sync_lang is defined and ai_gateway_contact_sync_lang %}
CONTACT_SYNC_LANG="{{ ai_gateway_contact_sync_lang }}"
{% endif %}
{% if ai_gateway_contact_sync_level_aliases is defined and ai_gateway_contact_sync_level_aliases %}
CONTACT_SYNC_LEVEL_ALIASES="{{ ai_gateway_contact_sync_level_aliases }}"
{% endif %}
{% if ai_gateway_contact_sync_level_names is defined and ai_gateway_contact_sync_level_names %}
CONTACT_SYNC_LEVEL_NAMES="{{ ai_gateway_contact_sync_level_names }}"
{% endif %}
{% if ai_gateway_contact_sync_admin_hint is defined and ai_gateway_contact_sync_admin_hint %}
CONTACT_SYNC_ADMIN_HINT="{{ ai_gateway_contact_sync_admin_hint }}"
{% endif %}
{% if ai_gateway_wuzapi_channel is defined and ai_gateway_wuzapi_channel %}
WUZAPI_CHANNEL="{{ ai_gateway_wuzapi_channel }}"
{% endif %}
