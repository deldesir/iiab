#!/bin/bash
# Nightly backup of the cognitive pipeline's stateful stores.
# SQLite files are copied with `.backup` (consistent even mid-write);
# the SiYuan workspace data dir is tarred. 7-day rotation.
set -euo pipefail

DEST=/library/backups/second-brain
STAMP=$(date +%F)
KEEP_DAYS=7

mkdir -p "$DEST/$STAMP"

backup_sqlite() {
  local src="$1" name="$2"
  if [ -f "$src" ]; then
    sqlite3 "$src" ".backup '$DEST/$STAMP/$name'"
    echo "sqlite ok: $name"
  else
    echo "MISSING: $src" >&2
  fi
}

backup_sqlite /opt/iiab/ai-gateway/talkmaster.db                          talkmaster.db
backup_sqlite /opt/iiab/ai-gateway/.mempalace/knowledge_graph.sqlite3     knowledge_graph.sqlite3
backup_sqlite /opt/iiab/ai-gateway/checkpoints.sqlite                     checkpoints.sqlite
backup_sqlite /library/jwlinker/jw_library.db                             jw_library.db

# WhatsApp session (whatsmeow store + wuzapi users) — losing these means
# re-linking the number, and repeated re-links raise the ban risk.
backup_sqlite /opt/iiab/wuzapi/dbdata/main.db                             wuzapi-main.db
backup_sqlite /opt/iiab/wuzapi/dbdata/users.db                            wuzapi-users.db

# Social Code training state (FSRS progress, XP, replay journal) — none of
# these are git-tracked; registers/emotions are rebuildable but cheap to keep.
backup_sqlite /opt/iiab/social-code/data/empathy_lab.db                   social-code-empathy.db
backup_sqlite /opt/iiab/social-code/apps/wit_gym/data/wit.db              social-code-wit.db
backup_sqlite /opt/iiab/social-code/apps/small_talk/src/small_talk/data/small_talk_i18n.db social-code-smalltalk.db
backup_sqlite /opt/iiab/social-code/data/registers/registers.db           social-code-registers.db
backup_sqlite /opt/iiab/social-code/data/emotions/emotions.db             social-code-emotions.db

# SiYuan workspace (notes + conf; excludes temp/history caches)
tar -czf "$DEST/$STAMP/siyuan-workspace.tar.gz" \
    --exclude='temp' --exclude='history' \
    -C /library siyuan 2>/dev/null
echo "siyuan workspace ok"

# MemPalace palace (ChromaDB) — the verbatim memory itself
tar -czf "$DEST/$STAMP/mempalace-palace.tar.gz" \
    -C /opt/iiab/ai-gateway/data palace 2>/dev/null
echo "palace ok"

# RapidPro media: contact/attachment uploads and, without S3, the inbound
# WhatsApp attachments courier stores here. The database alone can't rebuild
# these.
tar -czf "$DEST/$STAMP/rapidpro-media.tar.gz" \
    -C /opt/iiab/rapidpro media 2>/dev/null
echo "rapidpro media ok"

# Gateway persona/config env (secrets — kept 0600 via dir perms)
cp -a /opt/iiab/ai-gateway/.env "$DEST/$STAMP/ai-gateway.env"

# RBAC access grants — who may talk to the gateway and at what tier.
cp -a /opt/iiab/ai-gateway/data/access_grants.json "$DEST/$STAMP/access_grants.json" 2>/dev/null \
    && echo "access grants ok" || echo "WARN: access_grants.json missing" >&2

# Contact directory: the function catalog the gateway titles contacts with
# (operator data, not in git), and the operator's directory folder (grids,
# import kit, RapidPro flow exports, naming standard) when it exists.
cp -a /opt/iiab/ai-gateway/data/function_catalog.json "$DEST/$STAMP/function_catalog.json" 2>/dev/null \
    && echo "function catalog ok" || echo "note: no function_catalog.json"
# ICT help-desk texts the directory line answers with (operator-edited, not in git).
cp -a /opt/iiab/ai-gateway/data/ict_help.json "$DEST/$STAMP/ict_help.json" 2>/dev/null \
    && echo "ict help ok" || echo "note: no ict_help.json"
if [ -d /opt/iiab/msf-gonaives ]; then
    tar -czf "$DEST/$STAMP/directory-folder.tar.gz" -C /opt/iiab msf-gonaives \
        && echo "directory folder ok" || echo "WARN: directory folder backup failed" >&2
fi

# Operator quick-capture log — one-line jots (tickets, notes, people, pioneer
# hours) that feed the deliverable jobs and the shepherd/KG bridge. Nowhere else.
cp -a /opt/iiab/ai-gateway/data/captures.jsonl "$DEST/$STAMP/captures.jsonl" 2>/dev/null \
    && echo "captures ok" || echo "note: captures.jsonl not yet created" >&2

# Operator cockpit settings — chat-tuned config (ministry goal, snoozes, meeting
# days, field_group). Exists nowhere else; not regenerable.
cp -a /opt/iiab/ai-gateway/data/settings.json "$DEST/$STAMP/settings.json" 2>/dev/null \
    && echo "settings ok" || echo "note: settings.json not yet created" >&2

# LDC TWP assignment schedule — the operator's session/role rotation (source for
# the TWP notifier). Hand-authored, not regenerable. (ldc_twp_state.json is
# picked up by the *_state.json glob below.)
cp -a /opt/iiab/ai-gateway/data/ldc_twp.json "$DEST/$STAMP/ldc_twp.json" 2>/dev/null \
    && echo "ldc twp ok" || echo "note: ldc_twp.json not present" >&2

# Job state (run-once guards + kg-extract progress). Regenerable, but cheap to
# keep — avoids re-nudging / re-paying LLM extraction after a restore. Glob so
# any future *_state.json is covered automatically.
for s in /opt/iiab/ai-gateway/data/*_state.json; do
    [ -f "$s" ] && cp -a "$s" "$DEST/$STAMP/$(basename "$s")"
done
echo "job state ok"

# Postgres databases — temba holds contacts/messages/flow history,
# organized holds synced schedules + assignment responses. Flow DEFINITIONS
# are reproducible from git; conversation and sync history are not.
for db in temba organized; do
    sudo -u postgres pg_dump -Fc "$db" > "$DEST/$STAMP/$db.pgdump" 2>/dev/null \
        && echo "$db dump ok" || echo "WARN: $db dump failed" >&2
done

# Machine-local configuration that exists NOWHERE else — .env.local files
# hold box-only secrets Ansible never writes, local_vars.yml is the
# provisioning source of truth, and the send-auth token is generated once.
# Losing any of these means re-keying services by hand after a disk loss.
for f in /opt/iiab/ai-gateway/.env.local \
         /etc/iiab/organized.env.local \
         /etc/iiab/local_vars.yml \
         /etc/iiab/email_bridge_send_auth.token \
         /etc/iiab/fleet-backup.conf \
         /etc/iiab/fleet-backup.passphrase; do
    [ -f "$f" ] && cp -a "$f" "$DEST/$STAMP/$(echo "${f#/}" | tr / _)"
done
# Per-box backup passphrases (fleet-backup-mail new-passphrase): without them the
# bundles mailed to those boxes' own recipients can never be opened again.
[ -d /etc/iiab/fleet-backup.passphrase.d ] && tar -czf "$DEST/$STAMP/etc_iiab_fleet-backup.passphrase.d.tar.gz" \
    -C /etc/iiab fleet-backup.passphrase.d
echo "machine-local config ok"

# ── Fleet control plane (hub only; harmless where absent) ──────────────────────
# Inventory, release manifests, credentials file, check history and the monitor's DB,
# plus the fleet site's own database (the second Frappe site on this bench).
if [ -f /etc/iiab/fleet.yml ]; then
    mkdir -p "$DEST/$STAMP/fleet"
    for f in /etc/iiab/fleet.yml /etc/iiab/fleet.conf; do
        [ -f "$f" ] && cp -a "$f" "$DEST/$STAMP/fleet/"
    done
    [ -d /etc/iiab/fleet-releases ] && tar -czf "$DEST/$STAMP/fleet/fleet-releases.tar.gz" -C /etc/iiab fleet-releases
    [ -d /etc/iiab/fleet-vars ] && tar -czf "$DEST/$STAMP/fleet/fleet-vars.tar.gz" -C /etc/iiab fleet-vars
    [ -d /var/lib/fleet ] && tar -czf "$DEST/$STAMP/fleet/fleet-state.tar.gz" --exclude=venv -C /var/lib fleet
    [ -f /library/uptime-kuma/kuma.db ] && backup_sqlite /library/uptime-kuma/kuma.db uptime-kuma.db
    if [ -d /home/frappe/frappe-bench/sites/fleet.local ]; then
        sudo -u frappe -H bash -lc 'cd /home/frappe/frappe-bench && bench --site fleet.local backup --with-files' >/dev/null 2>&1
        newest=$(ls -t /home/frappe/frappe-bench/sites/fleet.local/private/backups/*-database.sql.gz 2>/dev/null | head -1)
        [ -n "$newest" ] && cp -a "$newest" "$DEST/$STAMP/fleet/" && echo "fleet site db ok"
        find /home/frappe/frappe-bench/sites/fleet.local/private/backups -type f -mtime +7 -delete 2>/dev/null
    fi
    # Semaphore UI (runbook front end): its config (keys + DB password) and its database
    if [ -f /etc/semaphore/config.json ]; then
        cp -a /etc/semaphore/config.json "$DEST/$STAMP/fleet/semaphore-config.json"
        sudo -u postgres pg_dump -Fc semaphore > "$DEST/$STAMP/fleet/semaphore.pgdump" 2>/dev/null && echo "semaphore db ok"
    fi
    echo "fleet control plane ok"
fi

chmod 700 "$DEST"
find "$DEST" -mindepth 1 -maxdepth 1 -type d -mtime +"$KEEP_DAYS" -exec rm -rf {} +

# ── Off-box copy of this snapshot (encrypted with the fleet passphrase) ───────────────────
# Without it the hub's own state (gateway, knowledge graph, captures, SiYuan, the fleet control
# plane) exists only on the hub's disk. Config: /etc/iiab/second-brain-offsite.conf with
# OFFSITE_HOST (ssh root@host, key-only), OFFSITE_DIR, OFFSITE_KEEP_DAYS. Restore:
#   gpg -d second-brain-<stamp>.tar.gpg | tar x
if [ -f /etc/iiab/second-brain-offsite.conf ] && [ -s /etc/iiab/fleet-backup.passphrase ]; then
    # shellcheck disable=SC1091
    . /etc/iiab/second-brain-offsite.conf
    OFFSITE_DIR=${OFFSITE_DIR:-/library/backups/hub-offsite}; OFFSITE_KEEP_DAYS=${OFFSITE_KEEP_DAYS:-14}
    if tar -C "$DEST" -cf - "$STAMP" \
        | gpg --batch --yes --quiet --symmetric --cipher-algo AES256 --passphrase-file /etc/iiab/fleet-backup.passphrase \
        | ssh -o BatchMode=yes -o ConnectTimeout=20 "root@$OFFSITE_HOST" \
            "mkdir -p '$OFFSITE_DIR' && cat > '$OFFSITE_DIR/second-brain-$STAMP.tar.gpg.part' && mv '$OFFSITE_DIR/second-brain-$STAMP.tar.gpg.part' '$OFFSITE_DIR/second-brain-$STAMP.tar.gpg' && find '$OFFSITE_DIR' -name 'second-brain-*.tar.gpg' -mtime +$OFFSITE_KEEP_DAYS -delete"; then
        echo "off-box copy ok: $OFFSITE_HOST:$OFFSITE_DIR/second-brain-$STAMP.tar.gpg"
    else
        echo "WARNING: off-box copy to $OFFSITE_HOST failed (the local snapshot is intact)"
    fi
fi
echo "backup complete: $DEST/$STAMP ($(du -sh "$DEST/$STAMP" | cut -f1))"
