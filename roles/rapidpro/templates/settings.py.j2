import os
import logging

logger = logging.getLogger(__name__)

# Ensure exceptions are logged
LOGGING = {
    "version": 1,
    "disable_existing_loggers": False,
    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
        },
    },
    "loggers": {
        "django.request": {
            "handlers": ["console"],
            "level": "ERROR",
            "propagate": True,
        },
    },
}

# ----------------------------------------------------------------------------------
# RapidPro settings file for IIAB
# ----------------------------------------------------------------------------------

from .settings_common import *  # noqa

# Disable debug mode for production
DEBUG = False

# SECURITY: Use a unique secret key per deployment
{% if rapidpro_secret_key %}
SECRET_KEY = "{{ rapidpro_secret_key }}"
{% endif %}



# The hostname of the IIAB box
# Hardcoded for Android/Proot stability
ALLOWED_HOSTS = ["*"]
INTERNAL_IPS = ["127.0.0.1"]

HOSTNAME = "{{ rapidpro_hostname }}"
BRAND["domain"] = "{{ rapidpro_hostname }}"
BRAND["hosts"] = ["{{ rapidpro_hostname }}", "localhost", "127.0.0.1", "box.lan"]

# ── Signup hardening ──────────────────────────────────────────────────────────
# Open self-signup lets anyone create a user and a workspace. Removing the
# "signups" brand feature closes both signup surfaces (accounts/signup and
# org/signup); invitation links still work (the allauth adapter honours invite
# secrets regardless), and with the console email backend the invitation mail
# lands in the journal for manual delivery.
BRAND["features"] = []  # no self-signup, no SSO
BRAND["emails"] = {"notifications": "support@{{ rapidpro_hostname }}"}

# temba v26.3.107: the internet/internal port split. Behind nginx on one port both stay None (the port check is
# then skipped); the internal-only API under /ti/ still requires INTERNAL_AUTH_TOKEN, which nginx only forwards on
# the loopback listener the realtime server uses.
INTERNET_PORT = None
INTERNAL_PORT = None
INTERNAL_AUTH_TOKEN = "{{ rapidpro_internal_auth_token | default(rapidpro_secret_key, true) }}"

# the WhatsApp bridge next door: the claim page creates bridge users with the admin token, and the bridge posts
# inbound webhooks to courier on this host
WUZAPI_URL = "http://127.0.0.1:{{ wuzapi_port }}"
WUZAPI_ADMIN_TOKEN = "{{ wuzapi_admintoken }}" or None
WUZAPI_COURIER_URL = "http://127.0.0.1:8080"

# there's no SMTP relay on the box: mail the app sends itself lands in the gunicorn journal, and nothing is
# verified or notified by email
MAILERS = {
    "default": {"BACKEND": "django.core.mail.backends.console.EmailBackend"},
    "custom_smtp": MAILERS["custom_smtp"],
}
ACCOUNT_EMAIL_VERIFICATION = "none"
ACCOUNT_EMAIL_NOTIFICATIONS = False
ACCOUNT_LOGIN_ON_EMAIL_CONFIRMATION = False
ACCOUNT_CONFIRM_EMAIL_ON_GET = False

# ----------------------------------------------------------------------------------
# Databases
# ----------------------------------------------------------------------------------
DATABASES = {
    "default": {
        "ENGINE": "django.contrib.gis.db.backends.postgis",
        "NAME": "{{ rapidpro_db_name }}",
        "USER": "{{ rapidpro_db_user }}",
        "PASSWORD": "{{ rapidpro_db_pass }}",
        "HOST": "127.0.0.1",
        "PORT": "5432",
    }
}
DATABASES["readonly"] = DATABASES["default"]

# ----------------------------------------------------------------------------------
# Caching
# ----------------------------------------------------------------------------------
CACHES = {
    "default": {
        "BACKEND": "django_valkey.cache.ValkeyCache",
        "LOCATION": "redis://127.0.0.1:6379/0",
        "OPTIONS": {"CLIENT_CLASS": "django_valkey.client.DefaultClient"},
    }
}

CELERY_BROKER_URL = "redis://127.0.0.1:6379/15"

{% if rapidpro_aws_enabled %}
# ----------------------------------------------------------------------------------
# DynamoDB
# ----------------------------------------------------------------------------------
DYNAMO_TABLE_PREFIX = "{{ rapidpro_dynamo_table_prefix }}"
DYNAMO_ENDPOINT_URL = None  # Override settings_common.py localhost:6000 — use real AWS DynamoDB

# ----------------------------------------------------------------------------------
# AWS S3 Storage
# ----------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID = "{{ rapidpro_aws_access_key_id }}"
AWS_SECRET_ACCESS_KEY = "{{ rapidpro_aws_secret_access_key }}"
AWS_REGION = "{{ rapidpro_aws_region }}"
AWS_S3_REGION_NAME = AWS_REGION
AWS_S3_ENDPOINT_URL = f"https://s3.{AWS_REGION}.amazonaws.com"
AWS_S3_ADDRESSING_STYLE = "path"
AWS_S3_FILE_OVERWRITE = False
BUCKET_PREFIX = "{{ rapidpro_s3_bucket_prefix }}"

STORAGES = {
    "default": {
        "BACKEND": "storages.backends.s3boto3.S3Boto3Storage",
        "OPTIONS": {"bucket_name": f"{BUCKET_PREFIX}-default"},
    },
    "archives": {
        "BACKEND": "storages.backends.s3boto3.S3Boto3Storage",
        "OPTIONS": {"bucket_name": f"{BUCKET_PREFIX}-archives"},
    },
    "public": {
        "BACKEND": "storages.backends.s3boto3.S3Boto3Storage",
        "OPTIONS": {
            "bucket_name": f"{BUCKET_PREFIX}-default",
            "default_acl": "public-read",
            "querystring_auth": False,
        },
    },
    "staticfiles": {"BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage"},
}

STORAGE_URL = f"{AWS_S3_ENDPOINT_URL}/{BUCKET_PREFIX}-default"
{% else %}
# ----------------------------------------------------------------------------------
# DynamoDB — disabled (local-first: all data stays in PostgreSQL)
# ----------------------------------------------------------------------------------
DYNAMO_TABLE_PREFIX = ""
DYNAMO_ENDPOINT_URL = None

# ----------------------------------------------------------------------------------
# Storage — Local Filesystem (no AWS dependencies)
# ----------------------------------------------------------------------------------
STORAGES = {
    "default": {"BACKEND": "django.core.files.storage.FileSystemStorage"},
    "archives": {"BACKEND": "django.core.files.storage.FileSystemStorage"},
    "public": {"BACKEND": "django.core.files.storage.FileSystemStorage"},
    "staticfiles": {"BACKEND": "django.contrib.staticfiles.storage.StaticFilesStorage"},
}

STORAGE_URL = "/rp/media"
{% endif %}

# ----------------------------------------------------------------------------------
# Mailroom - localhost for dev, no auth token
# ----------------------------------------------------------------------------------
MAILROOM_URL = os.environ.get("MAILROOM_URL", "http://127.0.0.1:8091")
MAILROOM_AUTH_TOKEN = os.environ.get("MAILROOM_AUTH_TOKEN")

# ----------------------------------------------------------------------------------
# Use Celery for background tasks
# ----------------------------------------------------------------------------------
CELERY_TASK_ALWAYS_EAGER = False

# ----------------------------------------------------------------------------------
# Asset compression — reduces page load time
# ----------------------------------------------------------------------------------
COMPRESS_ENABLED = True
COMPRESS_OFFLINE = False

# ----------------------------------------------------------------------------------
# Default user timezone
# ----------------------------------------------------------------------------------
USER_TIME_ZONE = "America/Port-au-Prince"

FORCE_SCRIPT_NAME = "{{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}"
STATIC_URL = "{{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}static/"
MEDIA_URL = "{{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}media/"
LOGIN_URL = "{{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}accounts/login/"
LOGIN_REDIRECT_URL = "{{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}org/choose/"
ACCOUNT_LOGOUT_REDIRECT_URL = "{{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}"

# ----------------------------------------------------------------------------------
# Email
# ----------------------------------------------------------------------------------
# Email delivery is configured by MAILERS in settings_common.py (console backend by default);
# Django 6.1 ignores EMAIL_BACKEND once MAILERS is defined.

# ----------------------------------------------------------------------------------
# Security
# ----------------------------------------------------------------------------------
ACCOUNT_DEFAULT_HTTP_PROTOCOL = "{{ rapidpro_http_protocol }}"

# ----------------------------------------------------------------------------------
# Allauth / Rate-limiting
# Tell allauth that exactly 1 trusted reverse proxy (nginx) sits in front,
# so it reads the real client IP from X-Forwarded-For instead of REMOTE_ADDR.
# Without this, logins return 403 "Unable to determine client IP address"
# because REMOTE_ADDR is empty/invalid on unix sockets.
# ----------------------------------------------------------------------------------
ALLAUTH_TRUSTED_PROXY_COUNT = 1

# Use HTTPS cookies and proxy headers
{% if rapidpro_http_protocol == 'https' %}
SECURE_PROXY_SSL_HEADER = ("HTTP_X_FORWARDED_PROTO", "https")
SESSION_COOKIE_SECURE = True
CSRF_COOKIE_SECURE = True
{% else %}
SECURE_PROXY_SSL_HEADER = None
SESSION_COOKIE_SECURE = False
CSRF_COOKIE_SECURE = False
{% endif %}

# Cookie security
SESSION_COOKIE_AGE = 1209600  # 2 weeks
CSRF_COOKIE_SAMESITE = "Strict"
CSRF_COOKIE_AGE = 1209600  # 2 weeks

# Password requirements
AUTH_PASSWORD_VALIDATORS = [
    {"NAME": "django.contrib.auth.password_validation.UserAttributeSimilarityValidator"},
    {"NAME": "django.contrib.auth.password_validation.MinimumLengthValidator", "OPTIONS": {"min_length": 8}},
    {"NAME": "django.contrib.auth.password_validation.CommonPasswordValidator"},
    {"NAME": "django.contrib.auth.password_validation.NumericPasswordValidator"},
]
