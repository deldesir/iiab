location = {{ rapidpro_url }} {
    return 301 {{ rapidpro_url }}/;
}

# temba v26.3.107: the internal-only API (/ti/) is for services on the box,
# never for the public entry. ^~ so no regex location below can catch it.
location ^~ {{ rapidpro_url }}/ti/ {
    return 404;
}

location {{ rapidpro_url }}/static/ {
    alias {{ rapidpro_dir }}/sitestatic/;
}

location {{ rapidpro_url }}/media/ {
    root {{ rapidpro_dir }};
    rewrite ^{{ rapidpro_url }}/media/(.*)$ /media/$1 break;
}

# Forward /api/internal/ to RapidPro — bell notifications, orgs list, shortcuts, templates
# Must use ^~ to beat the SiYuan regex catch-all: location ~ ^/api/(?!method/|resource/|v2/)
location ^~ /api/internal/ {
    rewrite ^/api/internal/(.*)$ {{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}api/internal/$1 break;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_set_header SCRIPT_NAME {{ rapidpro_url }};
    proxy_pass http://unix:{{ rapidpro_dir }}/run/gunicorn.sock;
}

# Forward /api/v2/ requests to RapidPro (not /api/ — ERPNext uses that)
location /api/v2/ {
    rewrite ^/api/v2/(.*)$ {{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}api/v2/$1 break;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_set_header SCRIPT_NAME {{ rapidpro_url }};
    proxy_pass http://unix:{{ rapidpro_dir }}/run/gunicorn.sock;
}

{% if rapidpro_centrifugo_enabled %}
# Realtime socket: temba-components' SocketService opens wss://<host>/ws/connect
# (a root path, not under {{ rapidpro_url }}). Exact match, so a /ws prefix
# location elsewhere (SiYuan's) never catches it. Centrifugo checks Origin
# itself; nginx passes the browser's headers through.
location = /ws/connect {
    proxy_pass http://127.0.0.1:{{ rapidpro_centrifugo_port }}/connection/websocket;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
    proxy_buffering off;
}
{% else %}
# No realtime server: answer the desk's socket attempts with a quiet 404 rather
# than letting a stricter /ws prefix location fill the error log with 403s.
location = /ws/connect {
    return 404;
}
{% endif %}

# Catch-all for RapidPro SPA paths — temba-components constructs URLs
# without the {{ rapidpro_url }} subpath prefix for all these top-level routes
location ~ ^/(flow|contact|msg|ticket|trigger|campaign|org|settings|staff|accounts|relayers|android|c|broadcast|channels|notification|globals|jsi18n|user)/ {
    rewrite ^/(.*)$ {{ rapidpro_url if rapidpro_url.endswith('/') else rapidpro_url + '/' }}$1 break;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_set_header SCRIPT_NAME {{ rapidpro_url }};
    proxy_pass http://unix:{{ rapidpro_dir }}/run/gunicorn.sock;
}

location {{ rapidpro_url }}/ {
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Host $http_host;
    proxy_set_header SCRIPT_NAME {{ rapidpro_url }};
    proxy_redirect off;
    proxy_pass http://unix:{{ rapidpro_dir }}/run/gunicorn.sock;
}